{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "framework": null,
  "installCommand": "cd .. && npm ci",
  "buildCommand": "node scripts/build-favicons.mjs && node ../scripts/write-release-manifest.mjs --site",
  "outputDirectory": ".",
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
      {"key": "X-Frame-Options", "value": "DENY"},
      {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"}
    ]}
  ],
  "rewrites": [
    {"source": "/.well-known/lnurlp/(.*)", "destination": "/api/breez-lnurl"},
    {"source": "/lnurlp/(.*)", "destination": "/api/breez-lnurl"},
    {"source": "/lnurlpay/(.*)", "destination": "/api/breez-lnurl"}
  ]
}
