@@ -0,0 +1,121 @@
+//! Exact plain-transfer reads used before and after one-shot incoming claims.
+//! Malformed, incomplete or conflicting evidence never reaches process_transfer.
+
+use super::*;
+use spark::ssp::{CurrencyAmount, CurrencyUnit};
+use spark::utils::paging::Order;
+
+fn invalid(message: &str) -> SparkWalletError {
+    SparkWalletError::Generic(message.to_owned())
+}
+
+fn select_direct(
+    page: PagingResult<Transfer>,
+    id: &TransferId,
+    ours: PublicKey,
+) -> Result<Option<Transfer>, SparkWalletError> {
+    if page.next.is_some() || page.items.len() > 1 {
+        return Err(invalid(
+            "Direct transfer observation is ambiguous or incomplete",
+        ));
+    }
+    let Some(transfer) = page.items.into_iter().next() else {
+        return Ok(None);
+    };
+    if transfer.id != *id
+        || transfer.receiver_identity_public_key != ours
+        || transfer.sender_identity_public_key == ours
+        || transfer.transfer_type != TransferType::Transfer
+        || transfer.total_value == 0
+        || transfer.total_value > 2_100_000_000_000_000
+    {
+        return Err(invalid(
+            "Observation is not this wallet's exact plain incoming transfer",
+        ));
+    }
+    Ok(Some(transfer))
+}
+
+fn exact_sats(amount: &CurrencyAmount) -> Result<u64, SparkWalletError> {
+    match amount.original_unit {
+        CurrencyUnit::Satoshi => Ok(amount.original_value),
+        CurrencyUnit::Millisatoshi if amount.original_value % 1000 == 0 => {
+            Ok(amount.original_value / 1000)
+        }
+        _ => Err(invalid("Direct transfer metadata has an inexact amount")),
+    }
+}
+
+fn project_direct(
+    transfer: Transfer,
+    mut provider: Vec<SspTransfer>,
+    htlcs: PagingResult<PreimageRequestWithTransfer>,
+    ours: PublicKey,
+    ssp: PublicKey,
+) -> Result<WalletTransfer, SparkWalletError> {
+    if provider.len() > 1 || !htlcs.items.is_empty() || htlcs.next.is_some() {
+        return Err(invalid(
+            "Direct transfer has ambiguous provider data or an HTLC obligation",
+        ));
+    }
+    if let Some(row) = provider.first() {
+        if row.spark_id.as_deref() != Some(transfer.id.to_string().as_str())
+            || row.user_request.is_some()
+            || exact_sats(&row.total_amount)? != transfer.total_value
+        {
+            return Err(invalid(
+                "Direct transfer provider data conflicts with its plain-transfer intent",
+            ));
+        }
+    }
+    Ok(WalletTransfer::from_transfer(
+        transfer,
+        provider.pop(),
+        None,
+        ours,
+        ssp,
+    ))
+}
+
+impl SparkWallet {
+    /// Fresh exact-ID evidence for a plain receive. Every source is bounded and
+    /// preserves ambiguous rows; no signing, claim, preimage release or retry.
+    pub async fn observe_direct_transfer(
+        &self,
+        id: TransferId,
+    ) -> Result<Option<WalletTransfer>, SparkWalletError> {
+        let paging = PagingFilter::new(Some(0), Some(2), Some(Order::Ascending));
+        let page = self
+            .transfer_service
+            .query_transfers_strict(std::slice::from_ref(&id), paging.clone())
+            .await?;
+        let Some(transfer) = select_direct(page, &id, self.identity_public_key)? else {
+            return Ok(None);
+        };
+        let provider = self.ssp_client.get_transfers(vec![id.to_string()]).await?;
+        let htlcs = self
+            .htlc_service
+            .query_htlc_strict(
+                QueryHtlcFilter {
+                    transfer_ids: vec![id.to_string()],
+                    payment_hashes: Vec::new(),
+                    identity_public_key: self.identity_public_key,
+                    match_role: PreimageRequestRole::ReceiverAndSender,
+                    status: None,
+                },
+                paging,
+            )
+            .await?;
+        project_direct(
+            transfer,
+            provider,
+            htlcs,
+            self.identity_public_key,
+            self.ssp_client.identity_public_key(),
+        )
+        .map(Some)
+    }
+}
+
+#[cfg(test)]
+mod tests;
