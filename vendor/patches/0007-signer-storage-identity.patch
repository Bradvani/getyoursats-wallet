+//! Raw-boundary reads for evidence which must not hide malformed rows or
+//! normalize an invalid continuation into a completed page. Legacy sync keeps
+//! its existing behavior; only explicit strict observers use this method.
+use super::{HtlcService, decode_payment_hashes};
+use crate::{
+    Network,
+    operator::rpc::spark::{QueryHtlcRequest, QueryHtlcResponse},
+    services::{PreimageRequestWithTransfer, QueryHtlcFilter, ServiceError},
+    utils::paging::{PagingFilter, PagingResult},
+};
+
+fn invalid(message: &str) -> ServiceError {
+    ServiceError::ValidationError(message.to_string())
+}
+
+// A local resource bound for strict observation, not a provider guarantee.
+const MAX_OBSERVATION_PAGE: i64 = 100;
+
+fn query_parameters(paging: &PagingFilter) -> Result<(i64, i64), ServiceError> {
+    let limit =
+        i64::try_from(paging.limit).map_err(|_| invalid("HTLC page limit exceeds RPC range"))?;
+    let offset =
+        i64::try_from(paging.offset).map_err(|_| invalid("HTLC page offset exceeds RPC range"))?;
+    if limit == 0 || limit > MAX_OBSERVATION_PAGE {
+        return Err(invalid("Strict HTLC page limit must be between 1 and 100"));
+    }
+    Ok((limit, offset))
+}
+
+fn strict_page(
+    response: QueryHtlcResponse,
+    paging: &PagingFilter,
+    network: Network,
+) -> Result<PagingResult<PreimageRequestWithTransfer>, ServiceError> {
+    let count = u64::try_from(response.preimage_requests.len())
+        .map_err(|_| invalid("HTLC page is oversized"))?;
+    let next = strict_continuation(response.offset, paging, count)?;
+    let items = response
+        .preimage_requests
+        .into_iter()
+        .map(|raw| {
+            let transfer = raw
+                .transfer
+                .as_ref()
+                .ok_or_else(|| invalid("HTLC transfer is missing"))?;
+            // Shared strict transfer validation must happen before TryFrom drops
+            // network and authoritative participant summaries.
+            crate::services::transfer::validate_observation_transfer(transfer, network)?;
+            #[allow(deprecated)]
+            if raw.receiver_identity_pubkey != transfer.receiver_identity_public_key
+                || (!raw.sender_identity_pubkey.is_empty()
+                    && raw.sender_identity_pubkey != transfer.sender_identity_public_key)
+            {
+                return Err(invalid("HTLC identities differ from its transfer"));
+            }
+            // Collect every conversion result. The ordinary convert_page helper
+            // deliberately skips a malformed row when any other row converts.
+            PreimageRequestWithTransfer::try_from(raw)
+        })
+        .collect::<Result<Vec<_>, _>>()?;
+    Ok(PagingResult { items, next })
+}
+
+fn strict_continuation(
+    raw_offset: i64,
+    paging: &PagingFilter,
+    count: u64,
+) -> Result<Option<PagingFilter>, ServiceError> {
+    query_parameters(paging)?;
+    if count > paging.limit {
+        return Err(invalid("HTLC page exceeds requested limit"));
+    }
+    // QueryHtlcResponse in the pinned proto explicitly defines -1 exhaustion.
+    // A default zero, another negative, or a nonadvancing cursor is not an
+    // alternate exhaustion marker. Preserve an advancing cursor literally;
+    // do not manufacture offset + limit or assume an undocumented page stride.
+    let next = if raw_offset == -1 {
+        None
+    } else {
+        let offset = u64::try_from(raw_offset).map_err(|_| invalid("Invalid HTLC continuation"))?;
+        if offset <= paging.offset || count == 0 {
+            return Err(invalid("HTLC continuation is empty or does not advance"));
+        }
+        Some(PagingFilter {
+            offset,
+            ..paging.clone()
+        })
+    };
+    Ok(next)
+}
+
+impl HtlcService {
+    /// One bounded raw-validated page. This never releases a preimage or
+    /// initiates/continues a swap. Absence is not non-execution evidence.
+    pub async fn query_htlc_strict(
+        &self,
+        filter: QueryHtlcFilter,
+        paging: PagingFilter,
+    ) -> Result<PagingResult<PreimageRequestWithTransfer>, ServiceError> {
+        let (limit, offset) = query_parameters(&paging)?;
+        let payment_hashes = decode_payment_hashes(&filter.payment_hashes)?;
+        if payment_hashes.iter().any(|h| h.len() != 32) {
+            return Err(invalid(
+                "Strict HTLC query requires complete payment hashes",
+            ));
+        }
+        let response = self
+            .operator_pool
+            .get_coordinator()
+            .client
+            .query_htlc(QueryHtlcRequest {
+                match_role: filter.match_role.into(),
+                payment_hashes,
+                transfer_ids: filter.transfer_ids,
+                identity_public_key: filter.identity_public_key.serialize().to_vec(),
+                status: filter
+                    .status
+                    .map(crate::operator::rpc::spark::PreimageRequestStatus::try_from)
+                    .transpose()?
+                    .map(Into::into),
+                limit,
+                offset,
+            })
+            .await?;
+        strict_page(response, &paging, self.network)
+    }
+}
