+//! Strict, bounded reads for one incoming Lightning obligation. No claim or
+//! preimage-release capability is called here. The ordinary history projection
+//! collapses enrichment rows into maps, which cannot establish uniqueness.
+use bitcoin::{hashes::sha256, secp256k1::PublicKey};
+use platform_utils::time::{Duration, UNIX_EPOCH};
+use spark::{
+    operator::rpc::spark::PreimageRequestRole,
+    services::{PreimageRequestWithTransfer, QueryHtlcFilter, Transfer, TransferId, TransferType},
+    ssp::{CurrencyUnit, SspTransfer},
+    utils::paging::{PagingFilter, PagingResult},
+};
+
+use super::SparkWallet;
+use crate::{SparkWalletError, WalletTransfer};
+
+fn invalid(message: &str) -> SparkWalletError {
+    SparkWalletError::Generic(message.to_string())
+}
+
+fn single<T>(page: PagingResult<T>) -> Result<Option<T>, SparkWalletError> {
+    if page.next.is_some() || page.items.len() > 1 {
+        return Err(invalid(
+            "Incoming Lightning observation is ambiguous or incomplete",
+        ));
+    }
+    Ok(page.items.into_iter().next())
+}
+
+fn correlate(
+    transfer: Transfer,
+    provider: SspTransfer,
+    htlc: PreimageRequestWithTransfer,
+    id: &TransferId,
+    payment_hash: sha256::Hash,
+    ours: PublicKey,
+    ssp: PublicKey,
+) -> Result<WalletTransfer, SparkWalletError> {
+    let nested = htlc
+        .transfer
+        .as_ref()
+        .ok_or_else(|| invalid("HTLC transfer is missing"))?;
+    let provider_sats = match provider.total_amount.original_unit {
+        CurrencyUnit::Satoshi => Some(provider.total_amount.original_value),
+        CurrencyUnit::Millisatoshi if provider.total_amount.original_value % 1000 == 0 => {
+            Some(provider.total_amount.original_value / 1000)
+        }
+        _ => None,
+    };
+    let expiry = transfer
+        .expiry_time
+        .and_then(|t| UNIX_EPOCH.checked_add(Duration::from_secs(t)));
+    let id_string = id.to_string();
+    if transfer.id != *id
+        || transfer.transfer_type != TransferType::PreimageSwap
+        || transfer.receiver_identity_public_key != ours
+        || transfer.sender_identity_public_key != ssp
+        || ours == ssp
+        || provider.spark_id.as_deref() != Some(id_string.as_str())
+        || provider_sats != Some(transfer.total_value)
+        || htlc.receiver_identity_pubkey != ours
+        || htlc.payment_hash != payment_hash
+        || expiry != Some(htlc.expiry_time)
+        || nested.id != transfer.id
+        || nested.transfer_type != transfer.transfer_type
+        || nested.sender_identity_public_key != transfer.sender_identity_public_key
+        || nested.receiver_identity_public_key != transfer.receiver_identity_public_key
+        || nested.total_value != transfer.total_value
+        || nested.expiry_time != transfer.expiry_time
+        || nested.status != transfer.status
+        || nested.spark_invoice != transfer.spark_invoice
+    {
+        return Err(invalid(
+            "Incoming Lightning operator, provider and HTLC correlation differs",
+        ));
+    }
+    Ok(WalletTransfer::from_transfer(
+        transfer,
+        Some(provider),
+        Some(htlc.into()),
+        ours,
+        ssp,
+    ))
+}
+
+impl SparkWallet {
+    /// Reads one exact incoming Lightning transfer with complete, unique
+    /// provider and receiver-role HTLC correlation. Absence remains unresolved.
+    /// Explicit limit-two pages avoid the generic pager's partial-success
+    /// behavior. No transaction signing, claim, sync or preimage disclosure.
+    pub async fn observe_incoming_lightning_transfer(
+        &self,
+        id: TransferId,
+        payment_hash: sha256::Hash,
+    ) -> Result<Option<WalletTransfer>, SparkWalletError> {
+        let Some(transfer) = single(
+            self.transfer_service
+                .query_transfers_strict(
+                    std::slice::from_ref(&id),
+                    PagingFilter::new(Some(0), Some(2), None),
+                )
+                .await?,
+        )?
+        else {
+            return Ok(None);
+        };
+        let provider = single(PagingResult::complete(
+            self.ssp_client.get_transfers(vec![id.to_string()]).await?,
+        ))?;
+        let Some(provider) = provider else {
+            return Ok(None);
+        };
+        let htlc = single(
+            self.htlc_service
+                .query_htlc_strict(
+                    QueryHtlcFilter {
+                        transfer_ids: vec![id.to_string()],
+                        payment_hashes: vec![payment_hash.to_string()],
+                        identity_public_key: self.identity_public_key,
+                        status: None,
+                        match_role: PreimageRequestRole::Receiver,
+                    },
+                    PagingFilter::new(Some(0), Some(2), None),
+                )
+                .await?,
+        )?;
+        let Some(htlc) = htlc else {
+            return Ok(None);
+        };
+        correlate(
+            transfer,
+            provider,
+            htlc,
+            &id,
+            payment_hash,
+            self.identity_public_key,
+            self.ssp_client.identity_public_key(),
+        )
+        .map(Some)
+    }
+}
