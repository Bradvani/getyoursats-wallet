+}
+
+fn paging(offset: u64) -> PagingFilter {
+    PagingFilter::new(
+        Some(offset),
+        Some(2),
+        Some(crate::utils::paging::Order::Ascending),
+    )
+}
+
+#[allow(deprecated)]
+fn decode(rows: Vec<proto::Transfer>, offset: i64) -> Result<PagingResult<Transfer>, ServiceError> {
+    let identity = PublicKey::from_slice(
