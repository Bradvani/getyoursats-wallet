@@ -0,0 +1,797 @@
+use super::*;
+use bitcoin::secp256k1::{Secp256k1, SecretKey};
+use platform_utils::time::Duration;
+use spark_wallet::{
+    LightningInvoice, LightningReceiveRequest, Preimage, PreimageRequest, SspTransfer, Transfer,
+};
+use std::{
+    collections::HashMap,
+    sync::{Arc, Mutex},
+};
+
+// Public, historic parser fixture. All identities and receipts below are local
+// test values. No network, signing service, preimage release or funds are used.
+const INVOICE: &str = "lnbc110n1p38q3gtpp5ypz09jrd8p993snjwnm68cph4ftwp22le34xd4r8ftspwshxhmnsdqqxqyjw5qcqpxsp5htlg8ydpywvsa7h3u4hdn77ehs4z4e844em0apjyvmqfkzqhhd2q9qgsqqqyssqszpxzxt9uuqzymr7zxcdccj5g69s8q7zzjs7sgxn9ejhnvdh6gqjcy22mss2yexunagm5r2gqczh8k24cwrqml3njskm548aruhpwssq9nvrvz";
+
+fn pk(byte: u8) -> PublicKey {
+    SecretKey::from_slice(&[byte; 32])
+        .unwrap()
+        .public_key(&Secp256k1::new())
+}
+fn amount(sats: u64) -> CurrencyAmount {
+    CurrencyAmount {
+        original_value: sats,
+        ..Default::default()
+    }
+}
+fn provider(t: &mut WalletTransfer) -> &mut LightningReceiveRequest {
+    let Some(SspUserRequest::LightningReceiveRequest(r)) = &mut t.user_request else {
+        panic!("fixture")
+    };
+    r
+}
+
+#[derive(Default)]
+struct State {
+    receipt: Option<WalletTransfer>,
+    values: HashMap<String, String>,
+    now: u64,
+    queries: Vec<(String, String)>,
+    writes: usize,
+    reads: usize,
+    query_error: bool,
+    query_pending: bool,
+    write_error: bool,
+    read_error_at: Option<usize>,
+    corrupt_write: bool,
+    expire_on_write: Option<u64>,
+}
+#[derive(Clone)]
+struct Fake(Arc<Mutex<State>>);
+
+#[macros::async_trait]
+impl ObservationIo for Fake {
+    async fn query(
+        &self,
+        id: TransferId,
+        hash: sha256::Hash,
+    ) -> Result<Option<WalletTransfer>, SdkError> {
+        let (pending, failed, receipt) = {
+            let mut s = self.0.lock().unwrap();
+            s.queries.push((id.to_string(), hash.to_string()));
+            (s.query_pending, s.query_error, s.receipt.clone())
+        };
+        if pending {
+            futures::future::pending::<()>().await;
+        }
+        if failed {
+            Err(invalid("disposable read failure"))
+        } else {
+            Ok(receipt)
+        }
+    }
+    async fn load(&self, key: String) -> Result<Option<String>, SdkError> {
+        let mut s = self.0.lock().unwrap();
+        s.reads += 1;
+        if s.read_error_at == Some(s.reads) {
+            return Err(invalid("disposable storage failure"));
+        }
+        Ok(s.values.get(&key).cloned())
+    }
+    async fn save(&self, key: String, value: String) -> Result<(), SdkError> {
+        let mut s = self.0.lock().unwrap();
+        s.writes += 1;
+        if s.write_error {
+            return Err(invalid("disposable write failure"));
+        }
+        let value = if s.corrupt_write {
+            format!("{value} ")
+        } else {
+            value
+        };
+        s.values.insert(key, value);
+        if let Some(now) = s.expire_on_write {
+            s.now = now;
+        }
+        Ok(())
+    }
+    fn now(&self) -> u64 {
+        self.0.lock().unwrap().now
+    }
+}
+
+fn fixture() -> (Fake, ObserveIncomingLightningRequest) {
+    let invoice = parse_invoice(INVOICE).unwrap();
+    assert_eq!(invoice.amount_msat, Some(11_000));
+    let r = ObserveIncomingLightningRequest {
+        payment_id: "00000000-0000-4000-8000-000000000001".into(),
+        identity_pubkey: pk(1).to_string(),
+        network: Network::Mainnet,
+        invoice: INVOICE.into(),
+        invoice_amount_sats: 11,
+        max_fee_sats: 2,
+        minimum_credit_sats: 9,
+        expected_binding_hash: None,
+    };
+    let expiry = invoice.timestamp + 60;
+    let raw = Transfer {
+        id: TransferId::from_str(&r.payment_id).unwrap(),
+        sender_identity_public_key: pk(2),
+        receiver_identity_public_key: pk(1),
+        status: TransferStatus::SenderKeyTweaked,
+        total_value: 10,
+        expiry_time: Some(expiry),
+        leaves: vec![],
+        created_time: Some(invoice.timestamp),
+        updated_time: Some(invoice.timestamp),
+        transfer_type: TransferType::PreimageSwap,
+        spark_invoice: None,
+    };
+    let provider = LightningReceiveRequest {
