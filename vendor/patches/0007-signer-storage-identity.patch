+fn intent_value() -> serde_json::Value {
+    serde_json::json!({"version":1,"txid":"a".repeat(64),"vout":0,"identity":keys().0.to_string(),
+        "network":"Regtest","amount":1000,"maxFee":10,"expiresAt":100})
+}
+
+fn receipt_fixture(number: usize) -> WalletTransfer {
+    let (ours, ssp) = keys();
+    let amount = |value| CurrencyAmount {
+        original_value: value,
+        ..Default::default()
+    };
+    let id = TransferId::from_str(&format!("00000000-0000-4000-8000-{number:012}")).unwrap();
+    let transfer = Transfer {
+        id: id.clone(),
+        sender_identity_public_key: ssp,
+        receiver_identity_public_key: ours,
+        status: TransferStatus::Completed,
+        total_value: 990,
+        expiry_time: None,
+        leaves: Vec::new(),
+        created_time: None,
+        updated_time: None,
+        transfer_type: TransferType::UtxoSwap,
+        spark_invoice: None,
+    };
+    let provider = SspTransfer {
+        total_amount: amount(990),
+        spark_id: Some(id.to_string()),
+        user_request: Some(SspUserRequest::ClaimStaticDeposit(ClaimStaticDepositInfo {
+            id: format!("deposit-request-{number}"),
+            created_at: std::time::SystemTime::UNIX_EPOCH.into(),
+            updated_at: std::time::SystemTime::UNIX_EPOCH.into(),
+            network: BitcoinNetwork::Regtest,
+            deposit_amount: amount(1000),
+            deposit_status: ClaimStaticDepositStatus::TransferCompleted,
+            credit_amount: amount(990),
+            max_fee: amount(10),
+            transaction_id: "a".repeat(64),
+            output_index: 0,
+            bitcoin_network: BitcoinNetwork::Regtest,
+            transfer_spark_id: Some(id.to_string()),
+        })),
+    };
+    WalletTransfer::from_transfer(transfer, Some(provider), None, ours, ssp)
+}
+
+fn unrelated(number: usize) -> WalletTransfer {
+    let mut transfer = receipt_fixture(number);
+    transfer.transfer_type = TransferType::Transfer;
+    transfer.user_request = None;
+    transfer
+}
+
+fn page(items: Vec<WalletTransfer>, next_offset: Option<u64>) -> PagingResult<WalletTransfer> {
+    PagingResult {
+        items,
+        next: next_offset.map(|offset| PagingFilter {
+            offset,
+            limit: PAGE_SIZE,
+            order: Order::Ascending,
+        }),
+    }
+}
+
+struct Fake {
+    original: Mutex<Option<String>>,
+    pages: Mutex<VecDeque<Result<PagingResult<WalletTransfer>, &'static str>>>,
+    requests: Mutex<Vec<(Option<String>, u64, u64)>>,
+    evidence: Mutex<HashMap<String, String>>,
+    writes: Mutex<usize>,
+    fail_write: bool,
+    corrupt_write: bool,
+    change_attempt_on_page: bool,
+    read_calls: AtomicUsize,
+    fail_read_at: Option<usize>,
+    pause_page_once: AtomicBool,
+    pause_write_once: AtomicBool,
+    paused: tokio::sync::Notify,
+    resume: tokio::sync::Notify,
+}
+
+impl Fake {
+    fn new(pages: Vec<PagingResult<WalletTransfer>>) -> Self {
+        Self {
+            original: Mutex::new(Some(intent_value().to_string())),
+            pages: Mutex::new(pages.into_iter().map(Ok).collect()),
+            requests: Mutex::new(Vec::new()),
+            evidence: Mutex::new(HashMap::new()),
+            writes: Mutex::new(0),
+            fail_write: false,
+            corrupt_write: false,
+            change_attempt_on_page: false,
+            read_calls: AtomicUsize::new(0),
+            fail_read_at: None,
+            pause_page_once: AtomicBool::new(false),
+            pause_write_once: AtomicBool::new(false),
+            paused: tokio::sync::Notify::new(),
+            resume: tokio::sync::Notify::new(),
+        }
+    }
+    fn success() -> Self {
+        let transfer = receipt_fixture(1);
+        Self::new(vec![
+            page(vec![transfer.clone()], None),
+            page(vec![transfer], None),
+        ])
+    }
+    async fn observe(&self) -> Result<ObserveDepositClaimResponse, SdkError> {
+        observe(self, request(), keys().0.to_string(), Network::Regtest).await
+    }
+}
+
+#[macros::async_trait]
+impl ObservationBackend for Fake {
+    async fn page(
+        &self,
+        id: Option<TransferId>,
+        paging: PagingFilter,
+    ) -> Result<PagingResult<WalletTransfer>, SdkError> {
+        self.requests.lock().unwrap().push((
+            id.map(|id| id.to_string()),
+            paging.offset,
+            paging.limit,
+        ));
+        if self.change_attempt_on_page {
+            let mut changed = intent_value();
+            changed["transferId"] = serde_json::json!(receipt_fixture(1).id.to_string());
+            *self.original.lock().unwrap() = Some(changed.to_string());
+        }
+        let result = self
+            .pages
+            .lock()
+            .unwrap()
+            .pop_front()
+            .expect("unexpected observation request")
+            .map_err(invalid);
+        if self.pause_page_once.swap(false, Ordering::SeqCst) {
+            self.paused.notify_one();
+            self.resume.notified().await;
+        }
+        result
+    }
+    async fn read(&self, key: &str) -> Result<Option<String>, SdkError> {
+        let call = self.read_calls.fetch_add(1, Ordering::SeqCst) + 1;
+        if self.fail_read_at == Some(call) {
+            return Err(invalid("storage read unavailable"));
+        }
+        if key == marker(&"a".repeat(64), 0) {
+            return Ok(self.original.lock().unwrap().clone());
+        }
+        assert!(key.starts_with("gys:mature-deposit-correlation:v1:"));
+        Ok(self.evidence.lock().unwrap().get(key).cloned())
+    }
+    async fn write(&self, key: &str, value: &str) -> Result<(), SdkError> {
+        assert!(
+            key.starts_with("gys:mature-deposit-correlation:v1:"),
+            "must never rewrite an attempt marker"
+        );
+        *self.writes.lock().unwrap() += 1;
+        if self.fail_write {
+            return Err(invalid("storage unavailable"));
+        }
+        self.evidence.lock().unwrap().insert(
+            key.to_owned(),
+            if self.corrupt_write {
+                "corrupted".to_owned()
+            } else {
+                value.to_owned()
+            },
+        );
+        if self.pause_write_once.swap(false, Ordering::SeqCst) {
+            self.paused.notify_one();
+            self.resume.notified().await;
+        }
+        Ok(())
+    }
+}
