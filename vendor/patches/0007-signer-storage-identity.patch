+        nanos: 0,
+    });
+    proto::PreimageRequestWithTransfer {
+        payment_hash: sha256::Hash::hash(&[3; 32]).to_byte_array().to_vec(),
+        receiver_identity_pubkey: transfer.receiver_identity_public_key.clone(),
+        sender_identity_pubkey: transfer.sender_identity_public_key.clone(),
+        status: proto::PreimageRequestStatus::PreimageShared as i32,
+        created_time: Some(prost_types::Timestamp {
+            seconds: 1,
+            nanos: 0,
+        }),
+        transfer: Some(transfer),
+        preimage: Some(vec![3; 32]),
+    }
+}
+
+fn decode(
+    rows: Vec<proto::PreimageRequestWithTransfer>,
+    offset: i64,
+) -> Result<PagingResult<PreimageRequestWithTransfer>, ServiceError> {
+    strict_page(
+        QueryHtlcResponse {
+            preimage_requests: rows,
+            offset,
+        },
+        &page(0),
+        Network::Mainnet,
+    )
+}
+
+#[macros::test_all]
+fn strict_htlc_only_explicit_minus_one_means_exhausted() {
+    for count in [0, 1, 2] {
+        assert!(strict_continuation(-1, &page(0), count).unwrap().is_none());
+        for cursor in [i64::MIN, -2, 0] {
+            assert!(
+                strict_continuation(cursor, &page(0), count).is_err(),
+                "{cursor}, {count}"
+            );
+        }
+    }
+    let empty = decode(vec![], -1).unwrap();
+    assert!(empty.items.is_empty() && empty.next.is_none());
+    assert!(decode(vec![], 0).is_err());
+}
+
+#[macros::test_all]
+fn strict_htlc_preserves_advancing_raw_cursor_without_inventing_stride() {
+    let next = strict_continuation(37, &page(10), 1).unwrap().unwrap();
+    assert_eq!(next.offset, 37);
+    assert_eq!(next.limit, 2);
+    assert_eq!(next.order, page(10).order);
+    for cursor in [0, 1, 9, 10] {
+        assert!(strict_continuation(cursor, &page(10), 1).is_err());
+    }
+    assert!(strict_continuation(37, &page(10), 0).is_err());
+}
+
+#[macros::test_all]
+fn strict_htlc_rejects_oversized_or_unrepresentable_pages() {
+    for cursor in [-1, 2] {
+        assert!(strict_continuation(cursor, &page(0), 3).is_err());
+    }
+    for paging in [
+        PagingFilter::new(Some(0), Some(0), None),
+        PagingFilter::new(Some(0), Some(101), None),
+        PagingFilter::new(Some(0), Some(i64::MAX as u64), None),
+        PagingFilter::new(Some(u64::MAX), Some(2), None),
+        PagingFilter::new(Some(0), Some(u64::MAX), None),
+    ] {
+        assert!(query_parameters(&paging).is_err());
+        assert!(strict_continuation(-1, &paging, 0).is_err());
+    }
+}
+
+#[macros::test_all]
+fn strict_htlc_complete_valid_row_survives_without_claim_or_release() {
+    let result = decode(vec![receipt()], -1).unwrap();
+    assert_eq!(result.items.len(), 1);
+    assert!(result.next.is_none());
+    assert_eq!(
+        result.items[0].preimage.as_ref().unwrap().compute_hash(),
+        result.items[0].payment_hash
+    );
+    // The pinned proto allows an absent sender identity on old HTLC records.
+    let mut old = receipt();
+    old.sender_identity_pubkey.clear();
+    assert_eq!(decode(vec![old], -1).unwrap().items.len(), 1);
+}
+
+#[macros::test_all]
+fn strict_htlc_valid_plus_malformed_row_never_becomes_unique_evidence() {
+    for field in [
+        "hash", "receiver", "transfer", "preimage", "created", "nestedId",
+    ] {
+        let good = receipt();
+        let mut bad = good.clone();
+        match field {
+            "hash" => bad.payment_hash.pop().map(|_| ()).unwrap(),
+            "receiver" => bad.receiver_identity_pubkey.clear(),
+            "transfer" => bad.transfer = None,
+            "preimage" => bad.preimage = Some(vec![0; 31]),
+            "created" => bad.created_time = None,
+            "nestedId" => bad.transfer.as_mut().unwrap().id = "invalid".into(),
+            _ => unreachable!(),
+        }
+        let rows = vec![good, bad];
+        // This positive control reproduces the old loss-of-evidence behavior.
+        let old = crate::services::models::convert_page::<_, PreimageRequestWithTransfer>(
+            rows.clone(),
+            "preimage request",
+        )
+        .unwrap();
+        assert_eq!(old.len(), 1, "{field}");
+        assert!(decode(rows, -1).is_err(), "{field}");
+    }
+}
+
+#[macros::test_all]
+fn strict_htlc_raw_fields_cannot_disappear_during_projection() {
+    for field in [
+        "network",
+        "unknownNetwork",
+        "sender",
+        "receiver",
+        "multipleReceivers",
+        "receiverAmount",
+    ] {
+        let mut raw = receipt();
+        match field {
+            "network" => raw.transfer.as_mut().unwrap().network = proto::Network::Regtest as i32,
+            "unknownNetwork" => raw.transfer.as_mut().unwrap().network = 0,
+            "sender" => raw.sender_identity_pubkey = raw.receiver_identity_pubkey.clone(),
+            "receiver" => raw.receiver_identity_pubkey = raw.sender_identity_pubkey.clone(),
+            "multipleReceivers" => {
+                let t = raw.transfer.as_mut().unwrap();
+                t.receivers.push(t.receivers[0].clone());
+            }
+            "receiverAmount" => raw.transfer.as_mut().unwrap().receivers[0].amount_sats += 1,
+            _ => unreachable!(),
+        }
+        // The regular converter accepts these raw contradictions or drops
+        // the affected fields. The strict path must reject before that loss.
+        assert!(
+            PreimageRequestWithTransfer::try_from(raw.clone()).is_ok(),
+            "{field}"
+        );
+        assert!(decode(vec![raw], -1).is_err(), "{field}");
+    }
+}
+
+#[macros::test_all]
+fn strict_htlc_default_or_invalid_cursor_cannot_make_one_row_complete() {
+    for cursor in [i64::MIN, -2, 0] {
+        assert!(decode(vec![receipt()], cursor).is_err(), "{cursor}");
+    }
+    let continued = decode(vec![receipt()], 37).unwrap();
+    assert_eq!(continued.next.unwrap().offset, 37);
+}
