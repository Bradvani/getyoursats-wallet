+#[macros::test_all]
+fn strict_transfer_single_receiver_status_mapping_rejects_each_conflicting_phase() {
+    use proto::{TransferReceiverStatus as R, TransferStatus as T};
+    for (status, receiver) in [
+        (T::SenderInitiated, R::Initiated),
+        (T::SenderKeyTweakPending, R::Initiated),
+        (T::SenderInitiatedCoordinator, R::Initiated),
+        (T::ApplyingSenderKeyTweak, R::Initiated),
+        (T::SenderKeyTweaked, R::ClaimPending),
+        (T::ReceiverKeyTweaked, R::KeyTweaked),
+        (T::ReceiverKeyTweakLocked, R::KeyTweakLocked),
+        (T::ReceiverKeyTweakApplied, R::KeyTweakApplied),
+        (T::ReceiverRefundSigned, R::RefundSigned),
+        (T::Completed, R::Completed),
+        (T::Expired, R::Cancelled),
+        (T::Returned, R::Cancelled),
+    ] {
+        let mut raw = observation_transfer_test_fixture(Network::Regtest);
+        raw.status = status as i32;
+        raw.receivers[0].status = receiver as i32;
+        validate_observation_transfer(&raw, Network::Regtest).unwrap();
+        for other in 0..=8 {
+            if other != receiver as i32 {
+                raw.receivers[0].status = other;
+                assert!(validate_observation_transfer(&raw, Network::Regtest).is_err());
+            }
+        }
+    }
+}
