+            storage
+                .compare_and_swap_cached_item("operation".into(), None, "submitted".into())
+                .await
+                .unwrap()
+        );
+        assert!(
+            !storage
+                .compare_and_swap_cached_item("operation".into(), None, "replacement".into())
+                .await
+                .unwrap()
+        );
+        assert!(
+            storage
+                .compare_and_swap_cached_item(
+                    "operation".into(),
+                    Some("submitted".into()),
+                    "receiving".into()
