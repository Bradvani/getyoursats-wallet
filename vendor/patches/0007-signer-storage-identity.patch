+#[tokio::test]
+async fn mature_deposit_observation_recovers_positive_correlation_and_preserves_expired_attempt() {
+    let backend = Fake::success();
+    let original = backend.original.lock().unwrap().clone();
+    let observed = backend.observe().await.unwrap();
+    assert!(observed.completed);
+    let correlation = observed.correlation.unwrap();
+    assert_eq!(correlation.transfer_id, receipt_fixture(1).id.to_string());
+    assert_eq!(correlation.ssp_request_id, "deposit-request-1");
+    assert_eq!(correlation.intent_hash.len(), 64);
+    let evidence = backend.evidence.lock().unwrap();
+    let encoded = evidence
+        .get(&format!(
+            "gys:mature-deposit-correlation:v1:{}",
+            correlation.correlation_id
+        ))
+        .unwrap();
+    assert_eq!(
+        sha256::Hash::hash(encoded.as_bytes()).to_string(),
+        correlation.correlation_id
+    );
+    assert_eq!(*backend.original.lock().unwrap(), original);
+    assert_eq!(*backend.writes.lock().unwrap(), 1);
+}
