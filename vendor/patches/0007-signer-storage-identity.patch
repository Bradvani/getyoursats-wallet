+++ b/crates/breez-sdk/core/src/sdk/incoming_lightning.rs
@@ -0,0 +1,431 @@
+//! Incoming Lightning evidence only. The IO boundary deliberately has no
+//! transaction signing, claim, sync or preimage-release capability. Consistent reads are
+//! not a transactional operator snapshot or an execution/settlement proof.
+use std::str::FromStr;
+
+use bitcoin::{
+    hashes::{Hash, sha256},
+    secp256k1::PublicKey,
+};
+use breez_sdk_common::input::{Bolt11InvoiceDetails, parse_invoice};
+use platform_utils::time::{SystemTime, UNIX_EPOCH};
+use serde::{Deserialize, Serialize};
+use spark_wallet::{
+    BitcoinNetwork as SspNetwork, CurrencyAmount, CurrencyUnit, LightningReceiveRequestStatus,
+    PreimageRequestStatus, SspUserRequest, TransferDirection, TransferFragmentUserRequestOn,
+    TransferId, TransferStatus, TransferType, WalletTransfer,
+};
+
+use crate::{
+    BreezSdk, IncomingLightningBinding, IncomingLightningObservationOutcome as Outcome, Network,
+    ObserveIncomingLightningRequest, ObserveIncomingLightningResponse, SdkError,
+};
+
+const MAX_SATS: u64 = 2_100_000_000_000_000;
+const PREFIX: &str = "gys:incoming-lightning-binding:v1:";
+// The pinned Spark invoice extension uses SCID 17592187092992000001.
+const SPARK_IDENTITY_HINT: &str = "16000000x16000000x1";
+
+fn invalid(message: &str) -> SdkError {
+    SdkError::InvalidInput(message.to_string())
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Intent {
+    payment_id: String,
+    identity_pubkey: String,
+    network: String,
+    invoice: String,
+    invoice_amount_sats: u64,
+    max_fee_sats: u64,
+    minimum_credit_sats: u64,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Binding {
+    version: u32,
+    intent: Intent,
+    ssp_identity_pubkey: String,
+    ssp_request_id: String,
+    payment_hash: String,
+    credit_sats: u64,
+    fee_sats: u64,
+    invoice_expires_at: u64,
+    htlc_expires_at: u64,
+}
+
+fn canonical(binding: &Binding) -> Result<String, SdkError> {
+    serde_json::to_string(binding).map_err(|_| invalid("Cannot encode incoming Lightning binding"))
+}
+
+fn digest(encoded: &str) -> String {
+    let mut bytes = PREFIX.as_bytes().to_vec();
+    bytes.push(0);
+    bytes.extend_from_slice(encoded.as_bytes());
+    sha256::Hash::hash(&bytes).to_string()
+}
+
+fn decode_binding(encoded: &str, expected: &str, intent: &Intent) -> Result<(), SdkError> {
+    if encoded.len() > 32_768 {
+        return Err(invalid("Incoming Lightning binding is oversized"));
+    }
+    let value: Binding = serde_json::from_str(encoded)
+        .map_err(|_| invalid("Incoming Lightning binding is malformed or unsupported"))?;
+    // Exact canonical bytes also reject positional arrays, duplicate keys and
+    // alternate encodings. Existing records are never repaired or overwritten.
+    if value.version != 1
+        || value.intent != *intent
+        || canonical(&value)? != encoded
+        || digest(encoded) != expected
+    {
+        return Err(invalid(
+            "Incoming Lightning binding differs from the retained intent",
+        ));
+    }
+    Ok(())
+}
+
+fn validate_identity_hints(invoice: &Bolt11InvoiceDetails, identity: &str) -> Result<(), SdkError> {
+    for route in &invoice.routing_hints {
+        for hop in &route.hops {
+            if hop.short_channel_id == SPARK_IDENTITY_HINT && hop.src_node_id != identity {
+                return Err(invalid("Invoice Spark receiver differs from this wallet"));
+            }
+        }
+    }
+    Ok(())
+}
+
+fn validate_intent(
+    r: &ObserveIncomingLightningRequest,
+    identity: &str,
+    network: Network,
+) -> Result<(Intent, Bolt11InvoiceDetails, TransferId), SdkError> {
+    let id = TransferId::from_str(&r.payment_id)
+        .map_err(|_| invalid("Invalid Lightning transfer id"))?;
+    let key = PublicKey::from_str(&r.identity_pubkey)
+        .map_err(|_| invalid("Invalid receiver identity"))?;
+    if id.to_string() != r.payment_id
+        || id.to_bytes() == [0; 16]
+        || key.to_string() != r.identity_pubkey
+        || r.identity_pubkey != identity
+        || r.network != network
+        || r.invoice_amount_sats == 0
+        || r.invoice_amount_sats > MAX_SATS
+        || r.max_fee_sats >= r.invoice_amount_sats
+        || r.minimum_credit_sats == 0
+        || r.minimum_credit_sats > r.invoice_amount_sats
+        || r.invoice.len() > 20_000
+        || !r.invoice.is_ascii()
+    {
+        return Err(invalid(
+            "Invalid incoming Lightning identity, network or economics",
+        ));
+    }
+    if let Some(hash) = &r.expected_binding_hash {
+        if hash.len() != 64
+            || !hash
+                .bytes()
+                .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+        {
+            return Err(invalid("Invalid incoming Lightning binding hash"));
+        }
+    }
+    let invoice =
+        parse_invoice(&r.invoice).ok_or_else(|| invalid("Invalid incoming Lightning invoice"))?;
+    if invoice.amount_msat != r.invoice_amount_sats.checked_mul(1000)
+        || invoice.network != network.into()
+        || invoice.expiry == 0
+        || invoice.timestamp.checked_add(invoice.expiry).is_none()
+    {
+        return Err(invalid(
+            "Invoice amount, network or expiry differs from the intent",
+        ));
+    }
+    validate_identity_hints(&invoice, identity)?;
+    let intent = Intent {
+        payment_id: r.payment_id.clone(),
+        identity_pubkey: identity.to_string(),
+        network: match network {
+            Network::Mainnet => "mainnet",
+            Network::Regtest => "regtest",
+            Network::Signet => "signet",
+        }
+        .into(),
+        invoice: r.invoice.to_ascii_lowercase(),
+        invoice_amount_sats: r.invoice_amount_sats,
+        max_fee_sats: r.max_fee_sats,
+        minimum_credit_sats: r.minimum_credit_sats,
+    };
+    Ok((intent, invoice, id))
+}
+
+fn exact_sats(amount: &CurrencyAmount) -> Result<u64, SdkError> {
+    let sats = match amount.original_unit {
+        CurrencyUnit::Satoshi => amount.original_value,
+        CurrencyUnit::Millisatoshi if amount.original_value % 1000 == 0 => {
+            amount.original_value / 1000
+        }
+        _ => return Err(invalid("Incoming Lightning amount is not exact satoshis")),
+    };
+    if sats == 0 || sats > MAX_SATS {
+        return Err(invalid("Invalid incoming Lightning amount"));
+    }
+    Ok(sats)
+}
+
+fn epoch(time: SystemTime) -> Result<u64, SdkError> {
+    let duration = time
+        .duration_since(UNIX_EPOCH)
+        .map_err(|_| invalid("Invalid HTLC expiry"))?;
+    if duration.subsec_nanos() != 0 {
+        return Err(invalid("HTLC expiry is not exact seconds"));
+    }
+    Ok(duration.as_secs())
+}
+
+fn correlate(
+    t: &WalletTransfer,
+    intent: &Intent,
+    invoice: &Bolt11InvoiceDetails,
+    network: Network,
+) -> Result<Binding, SdkError> {
+    let Some(SspUserRequest::LightningReceiveRequest(provider)) = &t.user_request else {
+        return Err(invalid(
+            "Incoming Lightning provider receive request is missing",
+        ));
+    };
+    let htlc = t
+        .htlc_preimage_request
+        .as_ref()
+        .ok_or_else(|| invalid("Incoming Lightning HTLC is missing"))?;
+    let nested = provider
+        .transfer
+        .as_ref()
+        .ok_or_else(|| invalid("Provider transfer correlation is missing"))?;
+    let provider_network = match network {
+        Network::Mainnet => SspNetwork::Mainnet,
+        Network::Regtest => SspNetwork::Regtest,
+        Network::Signet => SspNetwork::Signet,
+    };
+    let provider_invoice = &provider.invoice;
+    if t.id.to_string() != intent.payment_id
+        || t.receiver_id.to_string() != intent.identity_pubkey
+        || t.sender_id == t.receiver_id
+        || t.direction != TransferDirection::Incoming
+        || t.transfer_type != TransferType::PreimageSwap
+        || !t.is_ssp_transfer
+        || t.spark_invoice.is_some()
+        || provider.id.is_empty()
+        || provider.id.len() > 512
+        || !provider.id.bytes().all(|b| b.is_ascii_graphic())
+        || provider.network != provider_network
+        || provider_invoice.bitcoin_network != provider_network
+        || provider_invoice.encoded_invoice.len() > 20_000
+        || provider_invoice.encoded_invoice.to_ascii_lowercase() != intent.invoice
+        || parse_invoice(&provider_invoice.encoded_invoice).is_none()
+        || sha256::Hash::from_str(&provider_invoice.payment_hash).ok()
+            != sha256::Hash::from_str(&invoice.payment_hash).ok()
+        || htlc.payment_hash.to_string() != invoice.payment_hash
+        || exact_sats(&provider_invoice.amount)? != intent.invoice_amount_sats
+        || nested.spark_id.as_deref() != Some(intent.payment_id.as_str())
+        || exact_sats(&nested.total_amount)? != t.total_value_sat
+        || !matches!(&nested.user_request, Some(r) if r.id == provider.id && r.on == TransferFragmentUserRequestOn::LightningReceiveRequest)
+    {
+        return Err(invalid(
+            "Incoming Lightning receipt differs from the exact intent",
+        ));
+    }
+    let fee = intent
+        .invoice_amount_sats
+        .checked_sub(t.total_value_sat)
+        .ok_or_else(|| invalid("Incoming Lightning credit exceeds invoice amount"))?;
+    if t.total_value_sat == 0
+        || t.total_value_sat < intent.minimum_credit_sats
+        || fee > intent.max_fee_sats
+    {
+        return Err(invalid(
+            "Incoming Lightning credit or fee exceeds the approved bounds",
+        ));
+    }
+    let htlc_expiry = epoch(htlc.expiry_time)?;
+    if t.expiry_time.map(epoch).transpose()? != Some(htlc_expiry) {
+        return Err(invalid(
+            "Incoming Lightning transfer and HTLC expiries differ",
+        ));
+    }
+    let invoice_expiry = invoice
+        .timestamp
+        .checked_add(invoice.expiry)
+        .ok_or_else(|| invalid("Invalid invoice expiry"))?;
+    // The signed invoice is authoritative. An inconsistent SSP expiry is not
+    // silently substituted. Its record-creation timestamp need not be equal.
+    if u64::try_from(provider_invoice.invoice_expired_at.timestamp()).ok() != Some(invoice_expiry)
+        || provider_invoice.invoice_expired_at.timestamp_subsec_nanos() != 0
+    {
+        return Err(invalid("Provider expiry differs from the signed invoice"));
+    }
+    Ok(Binding {
+        version: 1,
+        intent: intent.clone(),
+        ssp_identity_pubkey: t.sender_id.to_string(),
+        ssp_request_id: provider.id.clone(),
+        payment_hash: invoice.payment_hash.clone(),
+        credit_sats: t.total_value_sat,
+        fee_sats: fee,
+        invoice_expires_at: invoice_expiry,
+        htlc_expires_at: htlc_expiry,
+    })
+}
+
+fn awaiting_preimage(t: &WalletTransfer, binding: &Binding, now: u64) -> bool {
+    let Some(SspUserRequest::LightningReceiveRequest(provider)) = &t.user_request else {
+        return false;
+    };
+    let Some(htlc) = &t.htlc_preimage_request else {
+        return false;
+    };
+    t.status == TransferStatus::SenderKeyTweaked
+        && htlc.status == PreimageRequestStatus::WaitingForPreimage
+        && htlc.preimage.is_none()
+        && provider.lightning_receive_payment_preimage.is_none()
+        && matches!(
+            provider.lightning_request_status,
+            LightningReceiveRequestStatus::HtlcReceived
+                | LightningReceiveRequestStatus::TransferCreated
+                | LightningReceiveRequestStatus::PaymentPreimagePending
+        )
+        && now < binding.invoice_expires_at
+        && now < binding.htlc_expires_at
+}
+
+#[macros::async_trait]
+trait ObservationIo {
+    async fn query(
+        &self,
+        id: TransferId,
+        hash: sha256::Hash,
+    ) -> Result<Option<WalletTransfer>, SdkError>;
+    async fn load(&self, key: String) -> Result<Option<String>, SdkError>;
+    async fn save(&self, key: String, value: String) -> Result<(), SdkError>;
+    fn now(&self) -> u64;
+}
+
+#[macros::async_trait]
+impl ObservationIo for BreezSdk {
+    async fn query(
+        &self,
+        id: TransferId,
+        hash: sha256::Hash,
+    ) -> Result<Option<WalletTransfer>, SdkError> {
+        Ok(self
+            .spark_wallet
+            .observe_incoming_lightning_transfer(id, hash)
+            .await?)
+    }
+    async fn load(&self, key: String) -> Result<Option<String>, SdkError> {
+        Ok(self.storage.get_cached_item(key).await?)
+    }
+    async fn save(&self, key: String, value: String) -> Result<(), SdkError> {
+        Ok(self.storage.set_cached_item(key, value).await?)
+    }
+    fn now(&self) -> u64 {
+        u64::from(breez_sdk_common::utils::now())
+    }
+}
+
+async fn observe(
+    io: &impl ObservationIo,
+    r: ObserveIncomingLightningRequest,
+    identity: &str,
+    network: Network,
+) -> Result<ObserveIncomingLightningResponse, SdkError> {
+    let (intent, invoice, id) = validate_intent(&r, identity, network)?;
+    if let Some(expected) = &r.expected_binding_hash {
+        let stored = io
+            .load(format!("{PREFIX}{expected}"))
+            .await?
+            .ok_or_else(|| invalid("Retained incoming Lightning binding is missing"))?;
+        decode_binding(&stored, expected, &intent)?;
+    }
+    let mut response = ObserveIncomingLightningResponse {
+        payment_id: r.payment_id,
+        identity_pubkey: identity.to_string(),
+        network,
+        observed_at: io.now(),
+        outcome: Outcome::Unresolved,
+        binding: None,
+    };
+    let hash = sha256::Hash::from_str(&invoice.payment_hash)
+        .map_err(|_| invalid("Invalid invoice payment hash"))?;
+    let Some(transfer) = io.query(id, hash).await? else {
+        return Ok(response);
+    };
+    let binding = correlate(&transfer, &intent, &invoice, network)?;
+    let encoded = canonical(&binding)?;
+    let binding_hash = digest(&encoded);
+    if r.expected_binding_hash
+        .as_ref()
+        .is_some_and(|h| *h != binding_hash)
+    {
+        return Err(invalid(
+            "Fresh incoming Lightning binding differs from the retained binding",
+        ));
+    }
+    if !awaiting_preimage(&transfer, &binding, io.now()) {
+        return Ok(response);
+    }
+    let key = format!("{PREFIX}{binding_hash}");
+    match io.load(key.clone()).await? {
+        Some(existing) => decode_binding(&existing, &binding_hash, &intent)?,
+        None => io.save(key.clone(), encoded.clone()).await?,
+    }
+    // Storage has no cross-instance CAS. These immutable, content-addressed
+    // bytes are only evidence. They do not reserve an attempt or prevent a
+    // different observation. The caller must retain and pin this binding hash.
+    if io.load(key).await? != Some(encoded) {
+        return Err(invalid("Incoming Lightning binding persistence failed"));
+    }
+    if !awaiting_preimage(&transfer, &binding, io.now()) {
+        return Ok(response);
+    }
+    response.outcome = Outcome::AwaitingPreimage;
+    response.binding = Some(IncomingLightningBinding {
+        binding_hash,
+        ssp_identity_pubkey: binding.ssp_identity_pubkey,
+        ssp_request_id: binding.ssp_request_id,
+        payment_hash: binding.payment_hash,
+        credit_sats: binding.credit_sats,
+        fee_sats: binding.fee_sats,
+        invoice_expires_at: binding.invoice_expires_at,
+        htlc_expires_at: binding.htlc_expires_at,
+    });
+    Ok(response)
+}
+
+#[cfg_attr(feature = "uniffi", uniffi::export(async_runtime = "tokio"))]
+#[macros::instance_span]
+impl BreezSdk {
+    /// Persist and freshly re-observe the exact incoming Lightning correlation.
+    /// Never claims, releases a preimage, signs a transaction, resumes a
+    /// payment, broadcasts or syncs. Read RPCs may authenticate normally.
+    /// This API provides neither completion nor non-execution proof. It does
+    /// not close the provider's transfer-bound release/recovery contract.
+    pub async fn observe_incoming_lightning(
+        &self,
+        request: ObserveIncomingLightningRequest,
+    ) -> Result<ObserveIncomingLightningResponse, SdkError> {
+        observe(
+            self,
+            request,
+            &self.spark_wallet.get_identity_public_key().to_string(),
+            self.config.network,
+        )
+        .await
+    }
+}
+
+#[cfg(test)]
+mod tests;
