+/// The storage identity must come from the same source as the wallet signer.
+/// An external signer has no seed and must never share a placeholder namespace.
+enum StorageIdentity {
+    Seed {
+        seed: breez_sdk_spark::Seed,
+        account_number: Option<u32>,
+    },
+    External(Arc<dyn breez_sdk_spark::signer::ExternalSparkSigner>),
+}
+
+impl StorageIdentity {
+    async fn public_key(&self, network: breez_sdk_spark::Network) -> WasmResult<PublicKey> {
+        match self {
+            Self::Seed {
+                seed,
+                account_number,
+            } => identity_public_key(&seed.to_bytes()?, network.into(), *account_number)
+                .map_err(WasmError::new),
+            Self::External(signer) => signer
+                .get_identity_public_key()
+                .await
+                .map_err(WasmError::new)?
+                .to_public_key()
+                .map_err(WasmError::new),
+        }
+    }
+}
+
+/// The core builder reads its signer identity again. Never give it stores
+/// opened for a different identity if an external signer changes across awaits.
+/// This binds the complete public key, not the legacy truncated file pathname.
+struct IdentityBoundBackend {
+    inner: Arc<dyn StorageBackend>,
+    network: breez_sdk_spark::Network,
+    identity: Vec<u8>,
+}
+
+#[macros::async_trait]
+impl StorageBackend for IdentityBoundBackend {
+    async fn create_stores(
+        &self,
+        network: breez_sdk_spark::Network,
+        identity: Vec<u8>,
+    ) -> Result<Arc<ResolvedStores>, SdkError> {
+        if network != self.network || identity != self.identity {
+            return Err(SdkError::InvalidInput(
+                "Signer identity changed before storage was bound to the wallet".to_string(),
+            ));
+        }
+        self.inner.create_stores(network, identity).await
+    }
+}
