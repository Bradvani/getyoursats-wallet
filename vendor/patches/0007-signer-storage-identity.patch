+//! Observation and durable correlation only. Never repeats a deposit submission
+//! or the receiving claim. Missing/partial evidence cannot clear an attempt.
+
+use super::*;
+use crate::DepositClaimCorrelation;
+use bitcoin::hashes::{Hash, sha256};
+use serde::{Deserialize, Serialize};
+use spark_wallet::{
+    BitcoinNetwork, ClaimStaticDepositStatus, CurrencyAmount, CurrencyUnit, Order, PagingFilter,
+    PagingResult, SspUserRequest,
+};
+use std::collections::HashSet;
+
+const PAGE_SIZE: u64 = 100;
+const MAX_PAGES: usize = 100;
+const MAX_RECORD_BYTES: usize = 8192;
+
+#[derive(Debug, Clone, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct StoredIntent {
+    pub(super) version: u8,
+    pub(super) txid: String,
+    pub(super) vout: u32,
+    pub(super) identity: String,
+    pub(super) network: String,
+    pub(super) amount: u64,
+    pub(super) max_fee: u64,
+    pub(super) expires_at: u64,
+    #[serde(
+        default,
+        deserialize_with = "present",
+        skip_serializing_if = "Option::is_none"
+    )]
+    pub(super) transfer_id: Option<String>,
+    #[serde(
+        default,
+        deserialize_with = "present",
+        skip_serializing_if = "Option::is_none"
+    )]
+    pub(super) receiving_attempted: Option<bool>,
+}
+
+fn present<'de, D, T>(deserializer: D) -> Result<Option<T>, D::Error>
+where
+    D: serde::Deserializer<'de>,
+    T: Deserialize<'de>,
+{
+    T::deserialize(deserializer).map(Some)
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct IntentBinding<'a> {
+    version: u8,
+    txid: &'a str,
+    vout: u32,
+    identity: &'a str,
+    network: &'a str,
+    amount: u64,
+    max_fee: u64,
+    expires_at: u64,
+}
+
+impl StoredIntent {
+    pub(super) fn parse(
+        raw: &str,
+        txid: &str,
+        vout: u32,
+        identity: &str,
+        network: Network,
+    ) -> Result<Self, SdkError> {
+        if raw.len() > MAX_RECORD_BYTES {
+            return Err(invalid("Deposit attempt record exceeds its size bound"));
+        }
+        if !matches!(
+            serde_json::from_str::<serde_json::Value>(raw),
+            Ok(serde_json::Value::Object(_))
+        ) {
+            return Err(invalid("Deposit attempt record must be a JSON object"));
+        }
+        // Deserialize the original bytes again rather than the Value: serde's
+        // struct visitor must still reject duplicate or unknown object fields.
+        let value: Self = serde_json::from_str(raw)
+            .map_err(|_| invalid("Deposit attempt record is damaged or incompatible"))?;
+        if value.version != 1
+            || value.txid != txid
+            || value.vout != vout
+            || value.identity != identity
+            || value.network != format!("{network:?}")
+            || value.amount == 0
+            || value.amount > 2_100_000_000_000_000
+            || value.max_fee >= value.amount
+            || value.expires_at == 0
+            || (value.receiving_attempted == Some(true) && value.transfer_id.is_none())
+        {
+            return Err(invalid(
+                "Deposit attempt record differs from its wallet or approved intent",
+            ));
+        }
+        if let Some(id) = &value.transfer_id {
+            let parsed = TransferId::from_str(id)
+                .map_err(|_| invalid("Deposit transfer record is invalid"))?;
+            if parsed.to_string() != *id {
+                return Err(invalid("Deposit transfer record is not canonical"));
+            }
+        }
+        Ok(value)
+    }
+
+    fn commitment(&self) -> Result<String, SdkError> {
+        let binding = IntentBinding {
+            version: 1,
+            txid: &self.txid,
+            vout: self.vout,
+            identity: &self.identity,
+            network: &self.network,
+            amount: self.amount,
+            max_fee: self.max_fee,
+            expires_at: self.expires_at,
+        };
+        Ok(sha256::Hash::hash(
+            &serde_json::to_vec(&binding)
+                .map_err(|_| invalid("Deposit intent commitment could not be encoded"))?,
+        )
+        .to_string())
+    }
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct CorrelationEvidence<'a> {
+    version: u8,
+    intent_hash: &'a str,
+    txid: &'a str,
+    vout: u32,
+    identity: &'a str,
+    network: &'a str,
+    amount_sats: u64,
+    credit_sats: u64,
+    transfer_id: &'a str,
+    ssp_request_id: &'a str,
+}
+
+#[macros::async_trait]
+trait ObservationBackend: Send + Sync {
+    async fn page(
+        &self,
+        id: Option<TransferId>,
+        paging: PagingFilter,
+    ) -> Result<PagingResult<WalletTransfer>, SdkError>;
+    async fn read(&self, key: &str) -> Result<Option<String>, SdkError>;
+    async fn write(&self, key: &str, value: &str) -> Result<(), SdkError>;
+}
+
+#[macros::async_trait]
+impl ObservationBackend for BreezSdk {
+    async fn page(
+        &self,
+        id: Option<TransferId>,
+        paging: PagingFilter,
+    ) -> Result<PagingResult<WalletTransfer>, SdkError> {
+        Ok(self
+            .spark_wallet
+            .observe_deposit_transfers(ListTransfersRequest {
+                transfer_ids: id.into_iter().collect(),
+                paging: Some(paging),
+            })
+            .await?)
+    }
+    async fn read(&self, key: &str) -> Result<Option<String>, SdkError> {
+        Ok(self.storage.get_cached_item(key.to_owned()).await?)
+    }
+    async fn write(&self, key: &str, value: &str) -> Result<(), SdkError> {
+        Ok(self
+            .storage
+            .set_cached_item(key.to_owned(), value.to_owned())
+            .await?)
+    }
+}
+
+pub(super) fn exact_sats(amount: &CurrencyAmount) -> Result<u64, SdkError> {
+    match amount.original_unit {
+        CurrencyUnit::Satoshi => Ok(amount.original_value),
+        CurrencyUnit::Millisatoshi if amount.original_value % 1000 == 0 => {
+            Ok(amount.original_value / 1000)
+        }
+        _ => Err(invalid(
+            "Deposit receipt has an unsupported or fractional-satoshi value",
+        )),
+    }
+}
+
+fn matching_receipt(
+    transfer: &WalletTransfer,
+    txid: &str,
+    vout: u32,
+    identity: &str,
+    network: Network,
+    intent: Option<&StoredIntent>,
+    exact_id: Option<&str>,
+) -> Result<Option<Payment>, SdkError> {
+    if exact_id.is_some_and(|id| id != transfer.id.to_string()) {
+        return Err(invalid("Deposit observation returned another transfer"));
+    }
+    let Some(SspUserRequest::ClaimStaticDeposit(deposit)) = &transfer.user_request else {
+        return if exact_id.is_some() {
+            Err(invalid("Exact deposit observation is incomplete"))
+        } else {
+            Ok(None)
+        };
+    };
+    if deposit.transaction_id != txid || deposit.output_index != i64::from(vout) {
+        return if exact_id.is_some() {
+            Err(invalid("Exact deposit observation names another outpoint"))
+        } else {
+            Ok(None)
+        };
+    }
+    let expected_network: BitcoinNetwork = spark_wallet::Network::from(network).into();
+    let deposited = exact_sats(&deposit.deposit_amount)?;
+    let credited = exact_sats(&deposit.credit_amount)?;
+    if deposit.network != expected_network
+        || deposit.bitcoin_network != expected_network
+        || deposit.id.is_empty()
+        || deposit.id.len() > 512
+        || deposit.transfer_spark_id.as_deref() != Some(transfer.id.to_string().as_str())
+        || !transfer.is_ssp_transfer
+        || deposited == 0
+        || deposited > 2_100_000_000_000_000
+        || credited == 0
+        || credited > deposited
+        || credited != transfer.total_value_sat
+    {
+        return Err(invalid(
+            "Deposit observation has inconsistent provider, network or amount correlation",
+        ));
+    }
+    let payment = receipt(transfer, txid, vout, identity, network)?;
+    if payment.amount != u128::from(credited) || payment.fees != u128::from(deposited - credited) {
+        return Err(invalid(
+            "Deposit payment projection differs from provider economics",
+        ));
+    }
+    if let Some(intent) = intent {
+        if deposited != intent.amount || deposited - credited > intent.max_fee {
+            return Err(invalid(
+                "Deposit observation exceeds the persisted approval",
+            ));
+        }
+    }
+    Ok(Some(payment))
+}
+
+fn validate_continuation(
+    page: &PagingResult<WalletTransfer>,
+    current: &PagingFilter,
+) -> Result<(), SdkError> {
+    if page.items.len() as u64 > current.limit {
+        return Err(invalid("Deposit observation exceeded its page bound"));
+    }
+    if let Some(next) = &page.next {
+        if page.items.is_empty()
+            || next.offset != current.offset + current.limit
+            || next.limit != current.limit
+            || next.order != current.order
+        {
+            return Err(invalid(
+                "Deposit observation did not provide a complete advancing page",
+            ));
+        }
+    }
+    Ok(())
+}
+
+async fn exact_transfer(
+    backend: &impl ObservationBackend,
+    id: &str,
+) -> Result<Option<WalletTransfer>, SdkError> {
+    let parsed = TransferId::from_str(id).map_err(|_| invalid("Invalid deposit transfer id"))?;
+    let result = backend
+        .page(
+            Some(parsed),
+            PagingFilter {
+                offset: 0,
+                limit: 2,
+                order: Order::Ascending,
+            },
+        )
+        .await?;
+    if result.next.is_some()
+        || result.items.len() > 1
+        || result.items.first().is_some_and(|t| t.id.to_string() != id)
+    {
+        return Err(invalid(
+            "Exact deposit observation is ambiguous or incomplete",
+        ));
+    }
+    Ok(result.items.into_iter().next())
+}
+
+// The one-shot receiving path uses the same strict raw, SSP and exact-page
+// validation as reconciliation before it can mark or execute a receiving claim.
+pub(super) async fn exact_deposit_transfer(
+    sdk: &BreezSdk,
+    id: &str,
+) -> Result<Option<WalletTransfer>, SdkError> {
+    exact_transfer(sdk, id).await
+}
+
+async fn discover(
+    backend: &impl ObservationBackend,
+    txid: &str,
+    vout: u32,
+    identity: &str,
+    network: Network,
+    intent: Option<&StoredIntent>,
+) -> Result<Option<WalletTransfer>, SdkError> {
+    let mut paging = PagingFilter {
+        offset: 0,
+        limit: PAGE_SIZE,
+        order: Order::Ascending,
+    };
+    let mut seen = HashSet::new();
+    let mut candidate = None;
+    for page_index in 0..MAX_PAGES {
+        let page = backend.page(None, paging.clone()).await?;
+        validate_continuation(&page, &paging)?;
+        for transfer in page.items {
+            if !seen.insert(transfer.id.to_string()) {
+                return Err(invalid(
+                    "Deposit observation repeated a transfer across pages",
+                ));
+            }
+            if let Some(payment) =
+                matching_receipt(&transfer, txid, vout, identity, network, intent, None)?
+            {
+                if candidate.is_some() {
+                    return Err(invalid("Multiple deposit receipts require review"));
+                }
+                candidate = Some((transfer, payment));
+            }
+        }
+        match page.next {
+            None => {
+                return match candidate {
+                    Some((previous, previous_payment)) => {
+                        let id = previous.id.to_string();
+                        let fresh = exact_transfer(backend, &id).await?;
+                        if let Some(fresh) = &fresh {
+                            let payment = matching_receipt(
+                                fresh,
+                                txid,
+                                vout,
+                                identity,
+                                network,
+                                intent,
+                                Some(&id),
+                            )?
+                            .ok_or_else(|| invalid("Fresh deposit receipt is missing"))?;
+                            let provider_id =
+                                |transfer: &WalletTransfer| match &transfer.user_request {
+                                    Some(SspUserRequest::ClaimStaticDeposit(deposit)) => {
+                                        Some(deposit.id.clone())
+                                    }
+                                    _ => None,
+                                };
+                            if provider_id(fresh) != provider_id(&previous)
+                                || payment.amount != previous_payment.amount
+                                || payment.fees != previous_payment.fees
+                            {
+                                return Err(invalid(
+                                    "Deposit correlation changed during the observation scan",
+                                ));
+                            }
+                        }
+                        Ok(fresh)
+                    }
+                    None => Ok(None),
+                };
+            }
+            Some(next) if page_index + 1 < MAX_PAGES => paging = next,
+            Some(_) => {
+                return Err(invalid(
+                    "Deposit observation reached its scan bound; evidence remains unresolved",
+                ));
+            }
+        }
+    }
+    unreachable!("Bounded deposit scan always returns")
+}
+
+// Execution callers still need their own atomic receiving reservation. This
+// helper supplies only fresh positive evidence, never cached retry authority.
+pub(super) async fn correlated_deposit_transfer(
+    sdk: &BreezSdk,
+    intent: &StoredIntent,
+) -> Result<Option<WalletTransfer>, SdkError> {
+    let transfer = match intent.transfer_id.as_deref() {
+        Some(id) => exact_transfer(sdk, id).await?,
+        None => {
+            discover(
+                sdk,
+                &intent.txid,
+                intent.vout,
+                &intent.identity,
+                sdk.config.network,
+                Some(intent),
+            )
+            .await?
+        }
+    };
+    if let Some(transfer) = &transfer {
+        let id = transfer.id.to_string();
+        matching_receipt(
+            transfer,
+            &intent.txid,
+            intent.vout,
+            &intent.identity,
+            sdk.config.network,
+            Some(intent),
+            Some(&id),
+        )?
+        .ok_or_else(|| invalid("Deposit continuation has no exact positive receipt"))?;
+    }
+    Ok(transfer)
+}
+
+async fn unchanged(
+    backend: &impl ObservationBackend,
+    key: &str,
+    original: &Option<String>,
+) -> Result<(), SdkError> {
+    if backend.read(key).await? != *original {
+        return Err(invalid(
+            "Deposit attempt changed during observation; preserve both records and observe again",
+        ));
+    }
+    Ok(())
+}
+
+async fn save_correlation(
+    backend: &impl ObservationBackend,
+    intent: &StoredIntent,
+    transfer: &WalletTransfer,
+) -> Result<DepositClaimCorrelation, SdkError> {
+    let Some(SspUserRequest::ClaimStaticDeposit(deposit)) = &transfer.user_request else {
+        return Err(invalid("Deposit correlation has no provider request"));
+    };
+    let intent_hash = intent.commitment()?;
+    let transfer_id = transfer.id.to_string();
+    let evidence = CorrelationEvidence {
+        version: 1,
+        intent_hash: &intent_hash,
+        txid: &intent.txid,
+        vout: intent.vout,
+        identity: &intent.identity,
+        network: &intent.network,
+        amount_sats: intent.amount,
+        credit_sats: transfer.total_value_sat,
+        transfer_id: &transfer_id,
+        ssp_request_id: &deposit.id,
+    };
+    let encoded = serde_json::to_string(&evidence)
+        .map_err(|_| invalid("Deposit correlation cannot be encoded"))?;
+    let correlation_id = sha256::Hash::hash(encoded.as_bytes()).to_string();
+    let key = format!("gys:mature-deposit-correlation:v1:{correlation_id}");
+    match backend.read(&key).await? {
+        Some(existing) if existing != encoded => {
+            return Err(invalid(
+                "Stored deposit correlation is damaged; preserve it",
+            ));
+        }
+        Some(_) => {}
+        None => backend.write(&key, &encoded).await?,
+    }
+    if backend.read(&key).await? != Some(encoded) {
+        return Err(invalid("Deposit correlation was not durably saved"));
+    }
+    // The content address permits only identical concurrent writes to this key.
+    // This is evidence storage, not compare-and-swap or permission to execute.
+    Ok(DepositClaimCorrelation {
+        correlation_id,
+        intent_hash,
+        transfer_id,
+        ssp_request_id: deposit.id.clone(),
+    })
+}
+
+async fn observe(
+    backend: &impl ObservationBackend,
+    request: FetchClaimDepositQuoteRequest,
+    identity: String,
+    network: Network,
+) -> Result<ObserveDepositClaimResponse, SdkError> {
+    let txid = Txid::from_str(&request.txid)
+        .map_err(|_| invalid("Invalid deposit transaction"))?
+        .to_string();
+    if txid != request.txid {
+        return Err(invalid("Deposit transaction must be canonical"));
+    }
+    let key = marker(&txid, request.vout);
+    let original = backend.read(&key).await?;
+    let intent = original
+        .as_deref()
+        .map(|raw| StoredIntent::parse(raw, &txid, request.vout, &identity, network))
+        .transpose()?;
+    let exact_id = intent
+        .as_ref()
+        .and_then(|intent| intent.transfer_id.as_deref());
+    let transfer = match exact_id {
+        Some(id) => exact_transfer(backend, id).await?,
+        None => {
+            discover(
+                backend,
+                &txid,
+                request.vout,
+                &identity,
+                network,
+                intent.as_ref(),
+            )
+            .await?
+        }
+    };
+    unchanged(backend, &key, &original).await?;
+    let mut result = ObserveDepositClaimResponse {
+        txid: txid.clone(),
+        vout: request.vout,
+        identity_pubkey: identity.clone(),
+        network,
+        observed_at: u64::from(breez_sdk_common::utils::now()),
+        completed: false,
+        payment: None,
+        correlation: None,
+    };
+    if let Some(transfer) = transfer {
+        let id = transfer.id.to_string();
+        let mut payment = matching_receipt(
+            &transfer,
+            &txid,
+            request.vout,
+            &identity,
+            network,
+            intent.as_ref(),
+            Some(&id),
+        )?
+        .ok_or_else(|| invalid("Fresh deposit correlation is missing"))?;
+        let Some(SspUserRequest::ClaimStaticDeposit(deposit)) = &transfer.user_request else {
+            unreachable!()
+        };
+        let provider_completed = matches!(
+            deposit.deposit_status,
+            ClaimStaticDepositStatus::TransferCompleted
+                | ClaimStaticDepositStatus::SpendTxCreated
+                | ClaimStaticDepositStatus::SpendTxBroadcast
+                | ClaimStaticDepositStatus::SpendTxConfirmed
+        );
+        result.completed = transfer.status == TransferStatus::Completed
+            && payment.status == PaymentStatus::Completed
+            && provider_completed;
+        if !result.completed && payment.status == PaymentStatus::Completed {
+            payment.status = PaymentStatus::Pending;
+        }
+        if let Some(intent) = &intent {
+            result.correlation = Some(save_correlation(backend, intent, &transfer).await?);
+        }
+        unchanged(backend, &key, &original).await?;
+        result.payment = Some(payment);
+        result.observed_at = u64::from(breez_sdk_common::utils::now());
+    }
+    Ok(result)
+}
+
+#[cfg_attr(feature = "uniffi", uniffi::export(async_runtime = "tokio"))]
+impl BreezSdk {
+    /// Observe an exact deposit with bounded complete reads and fresh correlation.
+    /// Stores only content-addressed evidence; never changes an attempt marker,
+    /// resumes a receiving claim, submits a deposit, or infers non-execution.
+    pub async fn observe_deposit_claim(
+        &self,
+        request: FetchClaimDepositQuoteRequest,
+    ) -> Result<ObserveDepositClaimResponse, SdkError> {
+        observe(
+            self,
+            request,
+            self.spark_wallet.get_identity_public_key().to_string(),
+            self.config.network,
+        )
+        .await
+    }
+}
