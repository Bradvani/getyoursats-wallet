+        );
+    }
+    pub(super) fn transfer() -> WalletTransfer {
+        use spark_wallet::{
+            BitcoinNetwork, ClaimStaticDepositInfo, ClaimStaticDepositStatus, CurrencyAmount,
+            CurrencyUnit, PublicKey, Transfer,
+        };
+        let pk = |fill: u8| {
+            let mut b = [fill; 33];
+            b[0] = 2;
+            PublicKey::from_slice(&b).unwrap()
+        };
+        let (ours, ssp) = (pk(1), pk(2));
+        let raw = Transfer {
+            id: TransferId::from_str(ID).unwrap(),
+            sender_identity_public_key: ssp,
+            receiver_identity_public_key: ours,
+            status: TransferStatus::SenderKeyTweaked,
+            total_value: 990,
+            expiry_time: None,
+            leaves: Vec::new(),
+            created_time: None,
+            updated_time: None,
+            transfer_type: TransferType::UtxoSwap,
+            spark_invoice: None,
+        };
+        let amount = |sats| CurrencyAmount {
+            original_value: sats,
+            original_unit: CurrencyUnit::Satoshi,
+            preferred_currency_unit: CurrencyUnit::Satoshi,
+            preferred_currency_value_rounded: sats,
+        };
+        let mut t = WalletTransfer::from_transfer(raw, None, None, ours, ssp);
+        t.user_request = Some(SspUserRequest::ClaimStaticDeposit(ClaimStaticDepositInfo {
+            id: "ssp-request".into(),
+            created_at: chrono::Utc::now(),
+            updated_at: chrono::Utc::now(),
+            network: BitcoinNetwork::Regtest,
+            deposit_amount: amount(1000),
+            deposit_status: ClaimStaticDepositStatus::TransferCreated,
+            credit_amount: amount(990),
+            max_fee: amount(10),
+            transaction_id: "a".repeat(64),
+            output_index: 2,
+            bitcoin_network: BitcoinNetwork::Regtest,
+            transfer_spark_id: Some(ID.into()),
+        }));
+        t
+    }
+    fn check(t: &WalletTransfer) -> Result<Payment, SdkError> {
+        receipt(
+            t,
+            &"a".repeat(64),
+            2,
+            &transfer().receiver_id.to_string(),
+            Network::Regtest,
+        )
+    }
+    #[test]
+    fn mature_deposit_receipt_requires_exact_ssp_operator_correlation() {
+        assert!(check(&transfer()).is_ok());
+    }
+    #[test]
+    fn mature_deposit_receipt_rejects_missing_or_other_transfer() {
+        for id in [None, Some("00000000-0000-4000-8000-000000000002".into())] {
+            let mut t = transfer();
+            let Some(SspUserRequest::ClaimStaticDeposit(d)) = &mut t.user_request else {
+                panic!()
+            };
+            d.transfer_spark_id = id;
+            assert!(check(&t).is_err());
+        }
+    }
+    #[test]
+    fn mature_deposit_receipt_rejects_other_networks() {
+        for field in [0, 1] {
+            let mut t = transfer();
+            let Some(SspUserRequest::ClaimStaticDeposit(d)) = &mut t.user_request else {
+                panic!()
+            };
+            if field == 0 {
+                d.network = spark_wallet::BitcoinNetwork::Mainnet;
+            } else {
+                d.bitcoin_network = spark_wallet::BitcoinNetwork::Mainnet;
+            }
+            assert!(check(&t).is_err());
+        }
+    }
+    #[test]
+    fn mature_deposit_receipt_rejects_other_credit() {
+        let mut t = transfer();
+        let Some(SspUserRequest::ClaimStaticDeposit(d)) = &mut t.user_request else {
+            panic!()
+        };
+        d.credit_amount.original_value = 989;
+        assert!(check(&t).is_err());
+    }
+    #[test]
+    fn mature_deposit_receipt_rejects_fractional_funding_and_credit_before_projection() {
+        for funding in [true, false] {
+            let mut t = transfer();
+            let Some(SspUserRequest::ClaimStaticDeposit(d)) = &mut t.user_request else {
+                panic!()
+            };
+            let amount = if funding {
+                &mut d.deposit_amount
+            } else {
+                &mut d.credit_amount
+            };
+            amount.original_unit = spark_wallet::CurrencyUnit::Millisatoshi;
+            amount.original_value = amount.original_value * 1000 + 1;
+            // The legacy as_sats projection truncates this amount to the
+            // otherwise valid fixture. Exact-unit validation must reject first.
+            assert!(check(&t).is_err());
+        }
+    }
+    #[test]
+    fn mature_deposit_receipt_rejects_invalid_deposit_bounds_before_projection() {
+        for funded in [0, 989, 2_100_000_000_000_001] {
+            let mut t = transfer();
+            let Some(SspUserRequest::ClaimStaticDeposit(d)) = &mut t.user_request else {
+                panic!()
+            };
+            d.deposit_amount.original_value = funded;
+            assert!(check(&t).is_err(), "funded {funded}");
+        }
+    }
+    #[test]
+    fn mature_deposit_receipt_accepts_whole_satoshi_millisatoshi_units() {
+        let mut t = transfer();
+        let Some(SspUserRequest::ClaimStaticDeposit(d)) = &mut t.user_request else {
+            panic!()
+        };
+        for amount in [&mut d.deposit_amount, &mut d.credit_amount] {
+            amount.original_unit = spark_wallet::CurrencyUnit::Millisatoshi;
+            amount.original_value *= 1000;
+        }
+        let payment = check(&t).unwrap();
+        assert_eq!(payment.amount, 990);
+        assert_eq!(payment.fees, 10);
+    }
+    #[test]
+    fn mature_deposit_receiving_requires_supported_operator_and_provider_state() {
+        use spark_wallet::ClaimStaticDepositStatus;
+        assert!(require_receivable(&transfer()).is_ok());
+        for status in [
+            TransferStatus::SenderInitiated,
+            TransferStatus::ReceiverKeyTweaked,
+            TransferStatus::Completed,
+            TransferStatus::Returned,
+            TransferStatus::Expired,
+        ] {
+            let mut t = transfer();
+            t.status = status;
+            assert!(require_receivable(&t).is_err());
+        }
+        for status in [
+            ClaimStaticDepositStatus::Created,
+            ClaimStaticDepositStatus::TransferCompleted,
+            ClaimStaticDepositStatus::TransferCreationFailed,
+            ClaimStaticDepositStatus::Unknown,
+        ] {
+            let mut t = transfer();
+            let Some(SspUserRequest::ClaimStaticDeposit(d)) = &mut t.user_request else {
+                panic!()
+            };
+            d.deposit_status = status;
+            assert!(require_receivable(&t).is_err());
+        }
+    }
+    #[test]
+    fn mature_deposit_receipt_rejects_other_wallet() {
+        let mut t = transfer();
+        t.receiver_id = t.sender_id;
+        assert!(check(&t).is_err());
+    }
+    #[tokio::test]
+    async fn mature_deposit_receiving_boundary_survives_sqlite_reopen() {
+        use crate::{Storage, persist::sqlite::SqliteStorage};
+        let path =
+            std::env::temp_dir().join(format!("gys-deposit-boundary-{}", uuid::Uuid::new_v4()));
+        let key = marker(&"a".repeat(64), 2);
+        let first = SqliteStorage::new(&path).unwrap();
+        first
+            .set_cached_item(key.clone(), original().to_string())
+            .await
+            .unwrap();
+        let raw = first.get_cached_item(key.clone()).await.unwrap().unwrap();
+        let mut attempt =
+            DepositAttempt::decode(&raw, &"a".repeat(64), 2, "wallet", Network::Regtest).unwrap();
+        attempt.authorize_receiving(ID).unwrap();
+        let encoded = serde_json::to_string(&attempt).unwrap();
+        first
+            .set_cached_item(key.clone(), encoded.clone())
+            .await
+            .unwrap();
+        assert_eq!(
+            first.get_cached_item(key.clone()).await.unwrap(),
+            Some(encoded.clone())
+        );
+        drop(first);
+        // A process interruption after this commit must not permit receiving again.
+        let reopened = SqliteStorage::new(&path).unwrap();
+        let saved = reopened.get_cached_item(key).await.unwrap().unwrap();
+        assert_eq!(saved, encoded);
+        let mut restored =
+            DepositAttempt::decode(&saved, &"a".repeat(64), 2, "wallet", Network::Regtest).unwrap();
+        assert!(restored.authorize_receiving(ID).is_err());
+        assert_eq!(restored.amount, 1000);
+        assert_eq!(restored.max_fee, 10);
+        drop(reopened);
+        std::fs::remove_dir_all(path).unwrap();
+    }
+}
