@@ -0,0 +1,139 @@
+//! Explicit, single-transfer BTC claims. Never a bulk sync or standing mandate.
+use super::attempt_store::reserve_attempt;
+use std::str::FromStr;
+use spark_wallet::{TransferId, TransferStatus, TransferType, TransferDirection, WalletTransfer};
+use crate::{BreezSdk, SdkError, Network, IncomingTransferRequest, ObserveIncomingTransferResponse,
+    Payment, PaymentType, PaymentMethod, utils::deposit_chain_syncer::TxOutput};
+
+fn invalid(message: &str) -> SdkError { SdkError::InvalidInput(message.to_string()) }
+fn validate_intent(request: &IncomingTransferRequest, identity: &str, network: Network, now: u64) -> Result<(), SdkError> {
+    if request.identity_pubkey != identity || request.network != network || request.amount_sats == 0 ||
+        request.amount_sats > 2_100_000_000_000_000 || request.expires_at <= now ||
+        request.expires_at > now.saturating_add(60) {
+        return Err(invalid("Incoming claim identity, amount, network or expiry is invalid"));
+    }
+    TransferId::from_str(&request.payment_id).map_err(|_| invalid("Invalid incoming transfer id"))?;
+    Ok(())
+}
+fn exact_transfer(t: &WalletTransfer, request: &IncomingTransferRequest) -> Result<(), SdkError> {
+    if t.id.to_string() != request.payment_id { return Err(invalid("Incoming transfer id differs from authorization")); }
+    if t.receiver_id.to_string() != request.identity_pubkey { return Err(invalid("Incoming transfer receiver differs from this wallet")); }
+    if t.direction != TransferDirection::Incoming { return Err(invalid("Incoming transfer direction is not receive")); }
+    if t.transfer_type != TransferType::Transfer { return Err(invalid("Incoming transfer is not a plain transfer")); }
+    if t.total_value_sat != request.amount_sats { return Err(invalid("Incoming transfer amount differs from authorization")); }
+    // An SSP identity can send an ordinary BTC transfer (including the faucet).
+    // Classify the operation by its protocol type and attached obligations, not
+    // by the sender's identity. Never allow an SSP request or HTLC through here.
+    if t.user_request.is_some() { return Err(invalid("Incoming transfer has an SSP user request")); }
+    if t.htlc_preimage_request.is_some() { return Err(invalid("Incoming transfer has an HTLC preimage request")); }
+    Ok(())
+}
+#[cfg_attr(feature = "uniffi", uniffi::export(async_runtime = "tokio"))]
+impl BreezSdk {
+    /// Fresh operator evidence for one incoming transfer. Missing is unresolved.
+    /// Does not claim, sign, resume, renew, broadcast or consume an approval.
+    pub async fn observe_incoming_transfer(&self, payment_id: String) -> Result<ObserveIncomingTransferResponse, SdkError> {
+        let id = TransferId::from_str(&payment_id).map_err(|_| invalid("Invalid incoming transfer id"))?;
+        let transfer = self.spark_wallet.observe_direct_transfer(id).await?;
+        let identity = self.spark_wallet.get_identity_public_key().to_string();
+        let mut result = ObserveIncomingTransferResponse { payment_id: payment_id.clone(), identity_pubkey: identity.clone(),
+            network: self.config.network, observed_at: u64::from(breez_sdk_common::utils::now()), completed: false, payment: None };
+        if let Some(t) = transfer {
+            let request = IncomingTransferRequest { payment_id, identity_pubkey: identity, network: self.config.network,
+                amount_sats: t.total_value_sat, expires_at: 0 };
+            exact_transfer(&t, &request)?;
+            result.completed = t.status == TransferStatus::Completed;
+            let payment = Payment::try_from(t)?;
+            if payment.payment_type != PaymentType::Receive || payment.method != PaymentMethod::Spark || payment.fees != 0 || payment.conversion_details.is_some() {
+                return Err(invalid("Unexpected direct transfer projection"));
+            }
+            result.payment = Some(payment);
+        }
+        Ok(result)
+    }
+    /// Claims only this exact direct BTC transfer, never Lightning, deposits,
+    /// tokens or counter-swaps. An attempt cannot be repeated after uncertainty.
+    pub async fn claim_incoming_transfer(&self, request: IncomingTransferRequest) -> Result<ObserveIncomingTransferResponse, SdkError> {
+        let identity = self.spark_wallet.get_identity_public_key().to_string();
+        validate_intent(&request, &identity, self.config.network, u64::from(breez_sdk_common::utils::now()))?;
+        let id = TransferId::from_str(&request.payment_id).map_err(|_| invalid("Invalid incoming transfer id"))?;
+        let _guard = self.claim_guards.try_acquire(TxOutput { txid: format!("incoming:{}", request.payment_id), vout: 0 })
+            .ok_or_else(|| invalid("Incoming claim already in progress"))?;
+        let key = format!("gys:incoming-claim:v1:{}", request.payment_id);
+        if self.storage.get_cached_item(key.clone()).await?.is_some() {
+            return Err(invalid("Incoming claim already attempted; reconcile without claiming again"));
+        }
+        let transfer = self.spark_wallet.observe_direct_transfer(id).await?
+            .ok_or_else(|| invalid("Incoming transfer not found"))?;
+        exact_transfer(&transfer, &request)?;
+        if transfer.status == TransferStatus::Completed || transfer.status == TransferStatus::Returned {
+            return Err(invalid("Incoming transfer no longer claimable"));
+        }
+        validate_intent(&request, &identity, self.config.network, u64::from(breez_sdk_common::utils::now()))?;
+        let intent = serde_json::json!({"paymentId": request.payment_id, "identityPubkey": request.identity_pubkey, "network": format!("{:?}", request.network), "amountSats": request.amount_sats, "expiresAt": request.expires_at}).to_string();
+        reserve_attempt(self, &key, None, &intent).await?;
+        validate_intent(&request, &identity, self.config.network, u64::from(breez_sdk_common::utils::now()))?;
+        self.spark_wallet.process_transfer(transfer).await?;
+        // Never manufacture Completed from a successful claim call. Re-query the
+        // operators; a pending or unavailable result remains uncertain in the UI.
+        self.observe_incoming_transfer(request.payment_id).await
+    }
+}
