+#[macros::test_all]
+fn strict_transfer_exact_id_requires_a_terminal_full_participant_response() {
+    let raw = observation_transfer_test_fixture(Network::Regtest);
+    let id = TransferId::from_str(&raw.id).unwrap();
+    let ours = PublicKey::from_slice(&raw.receivers[0].identity_public_key).unwrap();
+    for cursor in [-2, 0, 2] {
+        let response = proto::QueryTransfersResponse {
+            transfers: vec![raw.clone()],
+            offset: cursor,
+        };
+        assert!(
+            strict_page(
+                response,
+                &paging(0),
+                std::slice::from_ref(&id),
+                ours,
+                Network::Regtest
+            )
+            .is_err()
+        );
+    }
+    assert!(query_parameters(&paging(2), std::slice::from_ref(&id)).is_err());
+    let mut multiple = raw.clone();
+    multiple.receivers.push(multiple.receivers[0].clone());
+    let response = proto::QueryTransfersResponse {
+        transfers: vec![multiple],
+        offset: -1,
+    };
+    assert!(
+        strict_page(
+            response,
+            &paging(0),
+            std::slice::from_ref(&id),
+            ours,
+            Network::Regtest
+        )
+        .is_err()
+    );
+    let response = proto::QueryTransfersResponse {
+        transfers: vec![raw],
+        offset: -1,
+    };
+    assert_eq!(
+        strict_page(response, &paging(0), &[id], ours, Network::Regtest)
+            .unwrap()
+            .items
+            .len(),
+        1
+    );
+}
