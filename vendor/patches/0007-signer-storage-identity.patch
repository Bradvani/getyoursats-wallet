+ {
+    let backend = Arc::new(Fake::success());
+    backend.pause_write_once.store(true, Ordering::SeqCst);
+    let original = backend.original.lock().unwrap().clone();
+    let active = Arc::clone(&backend);
+    let operation = tokio::spawn(async move { active.observe().await });
+    backend.paused.notified().await;
+    operation.abort();
+    assert!(operation.await.unwrap_err().is_cancelled());
+    assert_eq!(*backend.original.lock().unwrap(), original);
+    assert_eq!(backend.evidence.lock().unwrap().len(), 1);
+    assert_eq!(*backend.writes.lock().unwrap(), 1);
+    let saved = backend.evidence.lock().unwrap().clone();
+
+    // A lost write acknowledgement leaves useful evidence, but a new empty
+    // provider read must still return unresolved and keep that evidence intact.
+    backend
+        .pages
+        .lock()
+        .unwrap()
+        .push_back(Ok(page(Vec::new(), None)));
+    let missing = backend.observe().await.unwrap();
+    assert!(!missing.completed);
+    assert!(missing.correlation.is_none());
+    assert!(missing.payment.is_none());
+    assert_eq!(*backend.evidence.lock().unwrap(), saved);
+
+    // Only another fresh discovery plus exact-ID read can return completion.
+    // Identical content-addressed evidence is reused without rewriting it.
+    backend.pages.lock().unwrap().extend([
+        Ok(page(vec![receipt_fixture(1)], None)),
+        Ok(page(vec![receipt_fixture(1)], None)),
+    ]);
+    assert!(backend.observe().await.unwrap().completed);
+    assert_eq!(backend.requests.lock().unwrap().len(), 5);
+    assert_eq!(*backend.writes.lock().unwrap(), 1);
+    assert_eq!(*backend.evidence.lock().unwrap(), saved);
+    assert_eq!(*backend.original.lock().unwrap(), original);
+}
