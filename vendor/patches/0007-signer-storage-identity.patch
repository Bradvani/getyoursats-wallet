+    #[test]
+    fn cached_item_compare_and_swap_has_one_winner_across_independent_connections() {
+        let path = directory();
+        let initial = SqliteStorage::new(&path).unwrap();
+        let runtime = tokio::runtime::Builder::new_current_thread()
+            .build()
+            .unwrap();
+        let mut expected: Option<String> = None;
+        for phase in ["submitted", "receiving"] {
+            let stores = [
+                SqliteStorage::new(&path).unwrap(),
+                SqliteStorage::new(&path).unwrap(),
+            ];
+            let barrier = Arc::new(Barrier::new(2));
+            let results: Vec<_> = std::thread::scope(|scope| {
+                let handles: Vec<_> = stores
+                    .into_iter()
+                    .enumerate()
+                    .map(|(index, storage)| {
+                        let barrier = barrier.clone();
+                        let expected = expected.clone();
+                        scope.spawn(move || {
+                            let value = format!("{phase}-{index}");
+                            let runtime = tokio::runtime::Builder::new_current_thread()
+                                .build()
+                                .unwrap();
+                            barrier.wait();
+                            let won = runtime
+                                .block_on(storage.compare_and_swap_cached_item(
+                                    "operation".into(),
+                                    expected,
+                                    value.clone(),
+                                ))
+                                .unwrap();
+                            (won, value)
+                        })
+                    })
+                    .collect();
+                handles
+                    .into_iter()
+                    .map(|handle| handle.join().unwrap())
+                    .collect()
+            });
+            let winners: Vec<_> = results.iter().filter(|(won, _)| *won).collect();
+            assert_eq!(winners.len(), 1);
+            expected = Some(winners[0].1.clone());
+            assert_eq!(
+                runtime
+                    .block_on(initial.get_cached_item("operation".into()))
+                    .unwrap(),
+                expected
+            );
+        }
+        drop(initial);
+        std::fs::remove_dir_all(path).unwrap();
+    }
