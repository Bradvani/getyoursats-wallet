+++ b/crates/breez-sdk/core/src/sdk/mature_deposit/continuation/tests.rs
@@ -0,0 +1,522 @@
+use super::*;
+use spark_wallet::ClaimStaticDepositStatus;
+use std::sync::{
+    Arc, Mutex,
+    atomic::{AtomicU8, AtomicU64, AtomicUsize, Ordering},
+};
+use tokio::sync::{Barrier, Notify};
+
+const NORMAL: u8 = 0;
+const FAIL_RESERVATION: u8 = 1;
+const LOST_RESERVATION_ACK: u8 = 2;
+const PAUSE_BEFORE_RESERVATION: u8 = 3;
+const PAUSE_AFTER_RESERVATION: u8 = 4;
+const PAUSE_IN_PROCESS: u8 = 5;
+const FAIL_PROCESS: u8 = 6;
+const FAIL_OBSERVATION: u8 = 7;
+const PENDING_OBSERVATION: u8 = 8;
+const FAIL_APPLY: u8 = 9;
+const FAIL_DELETE: u8 = 10;
+const EXPIRE_AFTER_QUERY: u8 = 11;
+const EXPIRE_AFTER_RESERVATION: u8 = 12;
+const WRONG_OBSERVATION: u8 = 13;
+const CONFLICTING_MANDATE: u8 = 14;
+
+struct State {
+    original: String,
+    value: Mutex<Option<String>>,
+    transfer: Mutex<Option<WalletTransfer>>,
+    mode: AtomicU8,
+    time: AtomicU64,
+    reads: AtomicUsize,
+    fail_read: AtomicUsize,
+    queries: AtomicUsize,
+    reservations: AtomicUsize,
+    processes: AtomicUsize,
+    observations: AtomicUsize,
+    applied: AtomicUsize,
+    deleted: AtomicUsize,
+    reached: Notify,
+    release: Notify,
+    query_barrier: Mutex<Option<Arc<Barrier>>>,
+    reservation_barrier: Mutex<Option<Arc<Barrier>>>,
+}
+
+#[derive(Clone)]
+struct FakeBackend(Arc<State>);
+
+impl FakeBackend {
+    fn new() -> Self {
+        let transfer = super::super::continuation_tests::transfer();
+        let mut original = super::super::continuation_tests::original();
+        original["identity"] = transfer.receiver_id.to_string().into();
+        let original = original.to_string();
+        Self(Arc::new(State {
+            original: original.clone(),
+            value: Mutex::new(Some(original)),
+            transfer: Mutex::new(Some(transfer)),
+            mode: AtomicU8::new(NORMAL),
+            time: AtomicU64::new(180),
+            reads: AtomicUsize::new(0),
+            fail_read: AtomicUsize::new(0),
+            queries: AtomicUsize::new(0),
+            reservations: AtomicUsize::new(0),
+            processes: AtomicUsize::new(0),
+            observations: AtomicUsize::new(0),
+            applied: AtomicUsize::new(0),
+            deleted: AtomicUsize::new(0),
+            reached: Notify::new(),
+            release: Notify::new(),
+            query_barrier: Mutex::new(None),
+            reservation_barrier: Mutex::new(None),
+        }))
+    }
+    fn request(&self) -> MatureDepositClaimRequest {
+        let mut request = super::super::continuation_tests::authorization();
+        request.identity_pubkey = super::super::continuation_tests::transfer()
+            .receiver_id
+            .to_string();
+        request
+    }
+    async fn run(&self) -> Result<ClaimDepositResponse, SdkError> {
+        let request = self.request();
+        continue_with(
+            self,
+            request.clone(),
+            request.identity_pubkey,
+            Network::Regtest,
+        )
+        .await
+    }
+    fn saved(&self) -> String {
+        self.0.value.lock().unwrap().clone().unwrap()
+    }
+    fn assert_reserved(&self) {
+        let value: serde_json::Value = serde_json::from_str(&self.saved()).unwrap();
+        assert_eq!(value["receivingAttempted"], true);
+        assert_eq!(value["expiresAt"], 150);
+        assert_eq!(value["amount"], 1000);
+        assert_eq!(value["maxFee"], 10);
+    }
+    fn complete_transfer(&self) {
+        let mut transfer = self.0.transfer.lock().unwrap();
+        let transfer = transfer.as_mut().unwrap();
+        transfer.status = TransferStatus::Completed;
+        let Some(SspUserRequest::ClaimStaticDeposit(deposit)) = &mut transfer.user_request else {
+            panic!()
+        };
+        deposit.deposit_status = ClaimStaticDepositStatus::TransferCompleted;
+    }
+}
+
+#[macros::async_trait]
+impl AttemptStore for FakeBackend {
+    async fn read_attempt(&self, _: &str) -> Result<Option<String>, SdkError> {
+        let read = self.0.reads.fetch_add(1, Ordering::SeqCst) + 1;
+        if read == self.0.fail_read.load(Ordering::SeqCst) {
+            return Err(invalid("injected read failure"));
+        }
+        Ok(self.0.value.lock().unwrap().clone())
+    }
+    async fn compare_and_swap_attempt(
+        &self,
+        _: &str,
+        expected: Option<&str>,
+        value: &str,
+    ) -> Result<bool, SdkError> {
+        self.0.reservations.fetch_add(1, Ordering::SeqCst);
+        let mode = self.0.mode.load(Ordering::SeqCst);
+        if mode == FAIL_RESERVATION {
+            return Err(invalid("unsupported or failed atomic reservation"));
+        }
+        if mode == PAUSE_BEFORE_RESERVATION {
+            self.0.reached.notify_one();
+            self.0.release.notified().await;
+        }
+        let barrier = self.0.reservation_barrier.lock().unwrap().clone();
+        if let Some(barrier) = barrier {
+            barrier.wait().await;
+        }
+        {
+            let mut current = self.0.value.lock().unwrap();
+            if current.as_deref() != expected {
+                return Ok(false);
+            }
+            *current = Some(value.to_owned());
+        }
+        if mode == LOST_RESERVATION_ACK {
+            return Err(invalid("reservation committed but acknowledgement lost"));
+        }
+        if mode == PAUSE_AFTER_RESERVATION {
+            self.0.reached.notify_one();
+            self.0.release.notified().await;
+        }
+        if mode == EXPIRE_AFTER_RESERVATION {
+            self.0.time.store(210, Ordering::SeqCst);
+        }
+        Ok(true)
+    }
+}
+
+#[macros::async_trait]
+impl ContinuationBackend for FakeBackend {
+    fn now(&self) -> u64 {
+        self.0.time.load(Ordering::SeqCst)
+    }
+    async fn transfer(&self, _: &DepositAttempt) -> Result<Option<WalletTransfer>, SdkError> {
+        self.0.queries.fetch_add(1, Ordering::SeqCst);
+        let barrier = self.0.query_barrier.lock().unwrap().clone();
+        let transfer = self.0.transfer.lock().unwrap().clone();
+        if let Some(barrier) = barrier {
+            barrier.wait().await;
+        }
+        if self.0.mode.load(Ordering::SeqCst) == EXPIRE_AFTER_QUERY {
+            self.0.time.store(210, Ordering::SeqCst);
+        }
+        Ok(transfer)
+    }
+    async fn conflicting_mandate(&self, _: &str, _: u32) -> Result<bool, SdkError> {
+        Ok(self.0.mode.load(Ordering::SeqCst) == CONFLICTING_MANDATE)
+    }
+    async fn process(&self, _: WalletTransfer) -> Result<(), SdkError> {
+        self.0.processes.fetch_add(1, Ordering::SeqCst);
+        match self.0.mode.load(Ordering::SeqCst) {
+            PAUSE_IN_PROCESS => {
+                self.0.reached.notify_one();
+                self.0.release.notified().await;
+            }
+            FAIL_PROCESS => return Err(invalid("uncertain receiving result")),
+            _ => {}
+        }
+        self.complete_transfer();
+        Ok(())
+    }
+    async fn observe(
+        &self,
+        request: FetchClaimDepositQuoteRequest,
+    ) -> Result<ObserveDepositClaimResponse, SdkError> {
+        self.0.observations.fetch_add(1, Ordering::SeqCst);
+        if self.0.mode.load(Ordering::SeqCst) == FAIL_OBSERVATION {
+            return Err(invalid("fresh observation unavailable"));
+        }
+        let transfer = self.0.transfer.lock().unwrap().clone().unwrap();
+        let mut payment = receipt(
+            &transfer,
+            &request.txid,
+            request.vout,
+            &transfer.receiver_id.to_string(),
+            Network::Regtest,
+        )?;
+        let pending = self.0.mode.load(Ordering::SeqCst) == PENDING_OBSERVATION;
+        if pending {
+            payment.status = PaymentStatus::Pending;
+        }
+        let wrong = self.0.mode.load(Ordering::SeqCst) == WRONG_OBSERVATION;
+        Ok(ObserveDepositClaimResponse {
+            txid: request.txid,
+            vout: request.vout + u32::from(wrong),
+            identity_pubkey: transfer.receiver_id.to_string(),
+            network: Network::Regtest,
+            observed_at: self.now(),
+            completed: !pending && transfer.status == TransferStatus::Completed,
+            payment: Some(payment),
+            correlation: None,
+        })
+    }
+    async fn apply_payment(&self, _: Payment) -> Result<(), SdkError> {
+        if self.0.mode.load(Ordering::SeqCst) == FAIL_APPLY {
+            return Err(invalid("payment write failed"));
+        }
+        self.0.applied.fetch_add(1, Ordering::SeqCst);
+        Ok(())
+    }
+    async fn delete_deposit(&self, _: &str, _: u32) -> Result<(), SdkError> {
+        if self.0.mode.load(Ordering::SeqCst) == FAIL_DELETE {
+            return Err(invalid("deposit record cleanup failed"));
+        }
+        self.0.deleted.fetch_add(1, Ordering::SeqCst);
+        Ok(())
+    }
+}
