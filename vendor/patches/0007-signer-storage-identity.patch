+//! Actual WASM-to-JavaScript public identity controls. The fixtures are public
+//! keys only. No SDK wallet, storage adapter, signing or network call is made.
+use super::{IdentityBoundBackend, StorageIdentity};
+use crate::signer::{JsExternalSparkSigner, WasmExternalSparkSigner};
+use bitcoin::secp256k1::PublicKey;
+use breez_sdk_spark::signer::ExternalSparkSigner;
+use breez_sdk_spark::{Network, ResolvedStores, SdkError, Seed, StorageBackend};
+use js_sys::{Array, Function, Object, Reflect};
+use std::{
+    str::FromStr,
+    sync::{
+        Arc,
+        atomic::{AtomicUsize, Ordering},
+    },
+};
+use wasm_bindgen::{JsCast, JsValue};
+use wasm_bindgen_test::*;
+
+const KEY_A: &str = "0279be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798";
+const KEY_B: &str = "02c6047f9441ed7d6d3045406e95c07cd85c778e4b8cef3ca7abac09b95c709ee5";
+
+fn fixture(body: &str) -> (Arc<WasmExternalSparkSigner>, Object) {
+    let object = Object::new();
+    for (name, key) in [("keyA", KEY_A), ("keyB", KEY_B)] {
+        let bytes = PublicKey::from_str(key).unwrap().serialize();
+        let array: Array = bytes.iter().map(|byte| JsValue::from(*byte)).collect();
+        Reflect::set(&object, &name.into(), &array).unwrap();
+    }
+    Reflect::set(&object, &"calls".into(), &0.into()).unwrap();
+    Reflect::set(
+        &object,
+        &"getIdentityPublicKey".into(),
+        &Function::new_no_args(body),
+    )
+    .unwrap();
+    let inner: JsExternalSparkSigner = object.clone().unchecked_into();
+    (Arc::new(WasmExternalSparkSigner::new(inner)), object)
+}
+
+fn calls(object: &Object) -> f64 {
+    Reflect::get(object, &"calls".into())
+        .unwrap()
+        .as_f64()
+        .unwrap()
+}
+
+#[wasm_bindgen_test]
+async fn storage_identity_bridge_reads_underlying_signer_each_time() {
+    let (signer, object) = fixture("this.calls++; return Promise.resolve({bytes:this.keyA});");
+    for _ in 0..3 {
+        assert_eq!(
+            signer
+                .get_identity_public_key()
+                .await
+                .unwrap()
+                .to_public_key()
+                .unwrap(),
+            PublicKey::from_str(KEY_A).unwrap()
+        );
+    }
+    assert_eq!(calls(&object), 3.0);
+}
+
+#[wasm_bindgen_test]
+async fn storage_identity_bridge_rejects_second_identity() {
+    let (signer, _) = fixture(
+        "this.calls++; return Promise.resolve({bytes:this.calls===1?this.keyA:this.keyB});",
+    );
+    assert!(signer.get_identity_public_key().await.is_ok());
+    assert!(
+        signer
+            .get_identity_public_key()
+            .await
+            .unwrap_err()
+            .to_string()
+            .contains("identity changed")
+    );
+}
+
+#[wasm_bindgen_test]
+async fn storage_identity_bridge_rejects_third_identity_after_storage_binding() {
+    let (signer, object) =
+        fixture("this.calls++; return Promise.resolve({bytes:this.calls<3?this.keyA:this.keyB});");
+    // This mirrors WASM namespace selection, core builder, then SparkWallet::new.
+    let source = StorageIdentity::External(signer.clone());
+    assert_eq!(
+        source.public_key(Network::Regtest).await.unwrap(),
+        PublicKey::from_str(KEY_A).unwrap()
+    );
+    assert!(signer.get_identity_public_key().await.is_ok());
+    assert!(
+        signer
+            .get_identity_public_key()
+            .await
+            .unwrap_err()
+            .to_string()
+            .contains("identity changed")
+    );
+    assert_eq!(calls(&object), 3.0);
+}
+
+#[wasm_bindgen_test]
+async fn storage_identity_bridge_propagates_later_signer_revocation() {
+    let (signer, object) = fixture(
+        "this.calls++; if(this.calls>1)return Promise.reject(new Error('test signer revoked')); return Promise.resolve({bytes:this.keyA});",
+    );
+    assert!(signer.get_identity_public_key().await.is_ok());
+    assert!(
+        signer
+            .get_identity_public_key()
+            .await
+            .unwrap_err()
+            .to_string()
+            .contains("test signer revoked")
+    );
+    assert_eq!(calls(&object), 2.0);
+}
+
+#[wasm_bindgen_test]
+async fn storage_identity_bridge_initial_error_does_not_pin_an_identity() {
+    let (signer, object) = fixture(
+        "this.calls++; if(this.calls===1)return Promise.reject(new Error('test identity unavailable')); return Promise.resolve({bytes:this.keyB});",
+    );
+    assert!(signer.get_identity_public_key().await.is_err());
+    assert_eq!(
+        signer
+            .get_identity_public_key()
+            .await
+            .unwrap()
+            .to_public_key()
+            .unwrap(),
+        PublicKey::from_str(KEY_B).unwrap()
+    );
+    assert_eq!(calls(&object), 2.0);
+}
+
+#[wasm_bindgen_test]
+async fn storage_identity_bridge_malformed_key_never_becomes_a_namespace() {
+    let (signer, _) =
+        fixture("this.calls++; return Promise.resolve({bytes:this.calls===1?[2,0]:this.keyA});");
+    let source = StorageIdentity::External(signer.clone());
+    assert!(source.public_key(Network::Mainnet).await.is_err());
+    assert_eq!(
+        source.public_key(Network::Mainnet).await.unwrap(),
+        PublicKey::from_str(KEY_A).unwrap()
+    );
+}
+
+#[wasm_bindgen_test]
+async fn storage_identity_bridge_rejects_malformed_read_after_valid_identity() {
+    let (signer, _) = fixture(
+        "this.calls++; return Promise.resolve({bytes:this.calls===1?this.keyA:[3,...Array(32).fill(255)]});",
+    );
+    assert!(signer.get_identity_public_key().await.is_ok());
+    assert!(signer.get_identity_public_key().await.is_err());
+}
+
+#[wasm_bindgen_test]
+async fn storage_identity_bridge_concurrent_differing_responses_cannot_replace_winner() {
+    let (signer, object) = fixture(
+        "this.calls++; if(this.calls===1)return new Promise(resolve=>{this.first=resolve;}); this.first({bytes:this.keyA}); return Promise.resolve({bytes:this.keyB});",
+    );
+    let first = signer.get_identity_public_key();
+    let second = signer.get_identity_public_key();
+    let (first, second) = platform_utils::tokio::join!(first, second);
+    assert!(first.is_ok() ^ second.is_ok());
+    let failure = first.err().or(second.err()).unwrap();
+    assert!(failure.to_string().contains("identity changed"));
+    assert_eq!(calls(&object), 2.0);
+}
+
+#[wasm_bindgen_test]
+async fn storage_identity_seeded_paths_retain_exact_legacy_default_derivation() {
+    let mnemonic = "abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about";
+    for (network, suffix) in [
+        (Network::Mainnet, "d2ea863c"),
+        (Network::Regtest, "da91de82"),
+        (Network::Signet, "da91de82"),
+    ] {
+        let source = StorageIdentity::Seed {
+            seed: Seed::Mnemonic {
+                mnemonic: mnemonic.to_string(),
+                passphrase: None,
+            },
+            account_number: None,
+        };
+        let identity = source.public_key(network).await.unwrap();
+        assert_eq!(
+            breez_sdk_spark::default_storage_path("spark-wallet-example", &network, &identity)
+                .unwrap()
+                .to_string_lossy(),
+            format!(
+                "spark-wallet-example/{}/{suffix}",
+                network.to_string().to_lowercase()
+            )
+        );
+    }
+}
+
+struct ProbeBackend(Arc<AtomicUsize>);
+
+#[macros::async_trait]
+impl StorageBackend for ProbeBackend {
+    async fn create_stores(
+        &self,
+        _network: Network,
+        _identity: Vec<u8>,
+    ) -> Result<Arc<ResolvedStores>, SdkError> {
+        self.0.fetch_add(1, Ordering::SeqCst);
+        Err(SdkError::Generic("test backend reached".to_string()))
+    }
+}
+
+#[wasm_bindgen_test]
+async fn storage_identity_bound_backend_rejects_different_full_identity_and_network() {
+    let calls = Arc::new(AtomicUsize::new(0));
+    let identity = PublicKey::from_str(KEY_A).unwrap().serialize().to_vec();
+    let backend = IdentityBoundBackend {
+        inner: Arc::new(ProbeBackend(calls.clone())),
+        network: Network::Regtest,
+        identity: identity.clone(),
+    };
+    for (network, key) in [
+        (Network::Mainnet, identity.clone()),
+        (
+            Network::Regtest,
+            PublicKey::from_str(KEY_B).unwrap().serialize().to_vec(),
+        ),
+        (Network::Regtest, vec![]),
+    ] {
+        assert!(
+            backend
+                .create_stores(network, key)
+                .await
+                .err()
+                .unwrap()
+                .to_string()
+                .contains("identity changed")
+        );
+    }
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+    assert!(
+        backend
+            .create_stores(Network::Regtest, identity)
+            .await
+            .err()
+            .unwrap()
+            .to_string()
+            .contains("test backend reached")
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+}
