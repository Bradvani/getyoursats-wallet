new file mode 100644
index 0000000000000000000000000000000000000000..214644cb5c4827be1a4560387ccb311a8ed3fa9a
--- /dev/null
+++ b/crates/breez-sdk/core/src/sdk/attempt_store.rs
@@ -0,0 +1,270 @@
+//! Durable same-store attempt reservations. No read/set emulation or retry
+//! authority after an uncertain commit acknowledgement.
+
+use crate::{BreezSdk, SdkError};
+
+fn invalid(message: &str) -> SdkError {
+    SdkError::InvalidInput(message.to_owned())
+}
+
+#[macros::async_trait]
+pub(super) trait AttemptStore: Send + Sync {
+    async fn read_attempt(&self, key: &str) -> Result<Option<String>, SdkError>;
+    async fn compare_and_swap_attempt(
+        &self,
+        key: &str,
+        expected: Option<&str>,
+        value: &str,
+    ) -> Result<bool, SdkError>;
+}
+
+#[macros::async_trait]
+impl AttemptStore for BreezSdk {
+    async fn read_attempt(&self, key: &str) -> Result<Option<String>, SdkError> {
+        Ok(self.storage.get_cached_item(key.to_owned()).await?)
+    }
+
+    async fn compare_and_swap_attempt(
+        &self,
+        key: &str,
+        expected: Option<&str>,
+        value: &str,
+    ) -> Result<bool, SdkError> {
+        Ok(self
+            .storage
+            .compare_and_swap_cached_item(
+                key.to_owned(),
+                expected.map(str::to_owned),
+                value.to_owned(),
+            )
+            .await?)
+    }
+}
+
+pub(super) async fn reserve_attempt(
+    store: &impl AttemptStore,
+    key: &str,
+    expected: Option<&str>,
+    value: &str,
+) -> Result<(), SdkError> {
+    // A no-op CAS cannot establish exclusive phase ownership: every caller
+    // could match the same unchanged value. Claim phases must advance.
+    if key.is_empty() || value.is_empty() || value.len() > 8192 || expected == Some(value) {
+        return Err(invalid(
+            "Operation reservation must advance a bounded attempt phase",
+        ));
+    }
+    if !store.compare_and_swap_attempt(key, expected, value).await? {
+        return Err(invalid(
+            "Operation attempt changed or was already reserved; preserve it and reconcile",
+        ));
+    }
+    // Readback is an additional corruption/lifetime check, not a substitute
+    // for atomic ownership. A lost acknowledgement never reaches this point.
+    if store.read_attempt(key).await?.as_deref() != Some(value) {
+        return Err(invalid("Atomic operation reservation readback failed"));
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::{
+        Arc, Mutex,
+        atomic::{AtomicU8, AtomicUsize, Ordering},
+    };
+    use tokio::sync::Notify;
+
+    const NORMAL: u8 = 0;
+    const FAIL_BEFORE: u8 = 1;
+    const FAIL_AFTER: u8 = 2;
+    const PAUSE_BEFORE: u8 = 3;
+    const PAUSE_AFTER: u8 = 4;
+    const READ_FAIL: u8 = 5;
+    const READ_CORRUPT: u8 = 6;
+
+    #[derive(Default)]
+    struct FakeStore {
+        value: Mutex<Option<String>>,
+        mode: AtomicU8,
+        reservations: AtomicUsize,
+        reached: Notify,
+        release: Notify,
+    }
+
+    #[macros::async_trait]
+    impl AttemptStore for FakeStore {
+        async fn read_attempt(&self, _: &str) -> Result<Option<String>, SdkError> {
+            match self.mode.load(Ordering::SeqCst) {
+                READ_FAIL => Err(invalid("read failed")),
+                READ_CORRUPT => Ok(Some("other bytes".to_owned())),
+                _ => Ok(self.value.lock().unwrap().clone()),
+            }
+        }
+        async fn compare_and_swap_attempt(
+            &self,
+            _: &str,
+            expected: Option<&str>,
+            value: &str,
+        ) -> Result<bool, SdkError> {
+            self.reservations.fetch_add(1, Ordering::SeqCst);
+            let mode = self.mode.load(Ordering::SeqCst);
+            if mode == FAIL_BEFORE {
+                return Err(invalid(
+                    "atomic reservation unsupported or failed before commit",
+                ));
+            }
+            if mode == PAUSE_BEFORE {
+                self.reached.notify_one();
+                self.release.notified().await;
+            }
+            {
+                let mut current = self.value.lock().unwrap();
+                if current.as_deref() != expected {
+                    return Ok(false);
+                }
+                *current = Some(value.to_owned());
+            }
+            if mode == FAIL_AFTER {
+                return Err(invalid("commit acknowledgement lost"));
+            }
+            if mode == PAUSE_AFTER {
+                self.reached.notify_one();
+                self.release.notified().await;
+            }
+            Ok(true)
+        }
+    }
+
+    #[tokio::test]
+    async fn attempt_store_requires_atomic_commit_and_exact_readback() {
+        let store = FakeStore::default();
+        reserve_attempt(&store, "key", None, "submitted")
+            .await
+            .unwrap();
+        reserve_attempt(&store, "key", Some("submitted"), "receiving")
+            .await
+            .unwrap();
+        assert_eq!(store.value.lock().unwrap().as_deref(), Some("receiving"));
+    }
+
+    #[tokio::test]
+    async fn attempt_store_mismatch_never_overwrites_or_accepts_existing_replacement() {
+        let store = FakeStore::default();
+        reserve_attempt(&store, "key", None, "receiving")
+            .await
+            .unwrap();
+        assert!(
+            reserve_attempt(&store, "key", None, "receiving")
+                .await
+                .is_err()
+        );
+        assert!(
+            reserve_attempt(&store, "key", Some("old"), "new")
+                .await
+                .is_err()
+        );
+        assert_eq!(store.value.lock().unwrap().as_deref(), Some("receiving"));
+    }
+
+    #[tokio::test]
+    async fn attempt_store_noop_or_unbounded_phase_never_calls_storage() {
+        let store = FakeStore::default();
+        for (key, expected, value) in [
+            ("", None, "new"),
+            ("key", None, ""),
+            ("key", Some("same"), "same"),
+        ] {
+            assert!(reserve_attempt(&store, key, expected, value).await.is_err());
+        }
+        assert!(
+            reserve_attempt(&store, "key", None, &"x".repeat(8193))
+                .await
+                .is_err()
+        );
+        assert_eq!(store.reservations.load(Ordering::SeqCst), 0);
+    }
+
+    #[tokio::test]
+    async fn attempt_store_failed_or_unsupported_reservation_never_mutates() {
+        let store = FakeStore::default();
+        store.mode.store(FAIL_BEFORE, Ordering::SeqCst);
+        assert!(
+            reserve_attempt(&store, "key", None, "receiving")
+                .await
+                .is_err()
+        );
+        assert_eq!(*store.value.lock().unwrap(), None);
+    }
+
+    #[tokio::test]
+    async fn attempt_store_lost_ack_preserves_committed_phase_without_authority() {
+        let store = FakeStore::default();
+        store.mode.store(FAIL_AFTER, Ordering::SeqCst);
+        assert!(
+            reserve_attempt(&store, "key", None, "receiving")
+                .await
+                .is_err()
+        );
+        store.mode.store(NORMAL, Ordering::SeqCst);
+        assert_eq!(store.value.lock().unwrap().as_deref(), Some("receiving"));
+        assert!(
+            reserve_attempt(&store, "key", None, "receiving")
+                .await
+                .is_err()
+        );
+    }
+
+    #[tokio::test]
+    async fn attempt_store_failed_or_corrupt_readback_keeps_reservation() {
+        for mode in [READ_FAIL, READ_CORRUPT] {
+            let store = FakeStore::default();
+            store.mode.store(mode, Ordering::SeqCst);
+            assert!(
+                reserve_attempt(&store, "key", None, "receiving")
+                    .await
+                    .is_err()
+            );
+            assert_eq!(store.value.lock().unwrap().as_deref(), Some("receiving"));
+        }
+    }
+
+    #[tokio::test]
+    async fn attempt_store_cancellation_before_commit_leaves_original_state() {
+        let store = Arc::new(FakeStore::default());
+        store.mode.store(PAUSE_BEFORE, Ordering::SeqCst);
+        let task = {
+            let store = store.clone();
+            tokio::spawn(
+                async move { reserve_attempt(store.as_ref(), "key", None, "receiving").await },
+            )
+        };
+        store.reached.notified().await;
+        task.abort();
+        assert!(task.await.unwrap_err().is_cancelled());
+        assert_eq!(*store.value.lock().unwrap(), None);
+    }
+
+    #[tokio::test]
+    async fn attempt_store_cancellation_after_commit_cannot_reserve_again() {
+        let store = Arc::new(FakeStore::default());
+        store.mode.store(PAUSE_AFTER, Ordering::SeqCst);
+        let task = {
+            let store = store.clone();
+            tokio::spawn(
+                async move { reserve_attempt(store.as_ref(), "key", None, "receiving").await },
+            )
+        };
+        store.reached.notified().await;
+        task.abort();
+        assert!(task.await.unwrap_err().is_cancelled());
+        store.mode.store(NORMAL, Ordering::SeqCst);
+        assert_eq!(store.value.lock().unwrap().as_deref(), Some("receiving"));
+        assert!(
+            reserve_attempt(store.as_ref(), "key", None, "receiving")
+                .await
+                .is_err()
+        );
+    }
+}
