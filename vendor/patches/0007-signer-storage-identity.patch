+        offset: -1,
+    };
+    assert!(strict_page(response(), &paging(0), &[], foreign, Network::Regtest).is_err());
+    let ours = PublicKey::from_slice(&raw.receivers[0].identity_public_key).unwrap();
+    let requested = TransferId::from_str("00000000-0000-4000-8000-000000000099").unwrap();
+    assert!(strict_page(response(), &paging(0), &[requested], ours, Network::Regtest).is_err());
