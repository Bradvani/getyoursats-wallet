@@ -0,0 +1,188 @@
+//! Continue only a freshly correlated, unreceived deposit. The backend exposes
+//! no static-deposit submission capability, and every receiving reservation is
+//! an acknowledged atomic transition of the exact original attempt bytes.
+
+use super::super::attempt_store::{AttemptStore, reserve_attempt};
+use super::*;
+
+#[macros::async_trait]
+trait ContinuationBackend: AttemptStore {
+    fn now(&self) -> u64;
+    async fn transfer(&self, intent: &DepositAttempt) -> Result<Option<WalletTransfer>, SdkError>;
+    async fn conflicting_mandate(&self, txid: &str, vout: u32) -> Result<bool, SdkError>;
+    async fn process(&self, transfer: WalletTransfer) -> Result<(), SdkError>;
+    async fn observe(
+        &self,
+        request: FetchClaimDepositQuoteRequest,
+    ) -> Result<ObserveDepositClaimResponse, SdkError>;
+    async fn apply_payment(&self, payment: Payment) -> Result<(), SdkError>;
+    async fn delete_deposit(&self, txid: &str, vout: u32) -> Result<(), SdkError>;
+}
+
+#[macros::async_trait]
+impl ContinuationBackend for BreezSdk {
+    fn now(&self) -> u64 {
+        u64::from(breez_sdk_common::utils::now())
+    }
+    async fn transfer(&self, intent: &DepositAttempt) -> Result<Option<WalletTransfer>, SdkError> {
+        observation::correlated_deposit_transfer(self, intent).await
+    }
+    async fn conflicting_mandate(&self, txid: &str, vout: u32) -> Result<bool, SdkError> {
+        Ok(self
+            .stored_deposit(txid, vout)
+            .await?
+            .is_some_and(|deposit| {
+                deposit.refund_tx.is_some()
+                    || deposit.instant_claim_status.is_some()
+                    || deposit.max_claim_fee.is_some()
+            }))
+    }
+    async fn process(&self, transfer: WalletTransfer) -> Result<(), SdkError> {
+        self.spark_wallet.process_transfer(transfer).await?;
+        Ok(())
+    }
+    async fn observe(
+        &self,
+        request: FetchClaimDepositQuoteRequest,
+    ) -> Result<ObserveDepositClaimResponse, SdkError> {
+        self.observe_deposit_claim(request).await
+    }
+    async fn apply_payment(&self, payment: Payment) -> Result<(), SdkError> {
+        self.storage.apply_payment_update(payment).await?;
+        Ok(())
+    }
+    async fn delete_deposit(&self, txid: &str, vout: u32) -> Result<(), SdkError> {
+        self.storage.delete_deposit(txid.to_owned(), vout).await?;
+        Ok(())
+    }
+}
+
+async fn require_unchanged(
+    backend: &impl AttemptStore,
+    key: &str,
+    expected: &str,
+) -> Result<(), SdkError> {
+    if backend.read_attempt(key).await?.as_deref() != Some(expected) {
+        return Err(invalid(
+            "Deposit attempt changed during continuation; preserve it",
+        ));
+    }
+    Ok(())
+}
+
+async fn continue_with(
+    backend: &impl ContinuationBackend,
+    request: MatureDepositClaimRequest,
+    identity: String,
+    network: Network,
+) -> Result<ClaimDepositResponse, SdkError> {
+    validate(&request, &identity, network, backend.now())?;
+    let key = marker(&request.txid, request.vout);
+    let original = backend
+        .read_attempt(&key)
+        .await?
+        .ok_or_else(|| invalid("Deposit continuation requires its original durable intent"))?;
+    let mut attempt =
+        DepositAttempt::decode(&original, &request.txid, request.vout, &identity, network)?;
+    attempt.matches_authorization(&request)?;
+    let transfer = backend
+        .transfer(&attempt)
+        .await?
+        .ok_or_else(|| invalid("Deposit submission remains unresolved; never resubmit"))?;
+    let transfer_id = transfer.id.to_string();
+    if attempt
+        .transfer_id
+        .as_deref()
+        .is_some_and(|id| id != transfer_id)
+    {
+        return Err(invalid(
+            "Deposit continuation changed its retained transfer",
+        ));
+    }
+    let payment = receipt(&transfer, &request.txid, request.vout, &identity, network)?;
+    economics(&payment, &request)?;
+    require_unchanged(backend, &key, &original).await?;
+    validate(&request, &identity, network, backend.now())?;
+    let mut expected = original;
+
+    if transfer.status != TransferStatus::Completed {
+        if attempt.receiving_attempted.is_some() {
+            return Err(invalid(
+                "Deposit receiving was already attempted; observe without repeating it",
+            ));
+        }
+        // Only the one supported pre-receiving operator/provider state can
+        // proceed. Intermediate, failed or contradictory states stay unresolved.
+        require_receivable(&transfer)?;
+        if backend
+            .conflicting_mandate(&request.txid, request.vout)
+            .await?
+        {
+            return Err(invalid(
+                "A conflicting refund or deposit mandate requires reconciliation",
+            ));
+        }
+        attempt.authorize_receiving(&transfer.id.to_string())?;
+        validate(&request, &identity, network, backend.now())?;
+        let next = serde_json::to_string(&attempt)
+            .map_err(|_| invalid("Cannot encode deposit continuation"))?;
+        reserve_attempt(backend, &key, Some(&expected), &next).await?;
+        expected = next;
+        validate(&request, &identity, network, backend.now())?;
+        backend.process(transfer).await?;
+    }
+
+    // A successful process call is not a completion receipt. The production
+    // observer requires fresh full operator, exact provider and completed state.
+    let observed = backend
+        .observe(FetchClaimDepositQuoteRequest {
+            txid: request.txid.clone(),
+            vout: request.vout,
+        })
+        .await?;
+    if !observed.completed
+        || observed.txid != request.txid
+        || observed.vout != request.vout
+        || observed.identity_pubkey != identity
+        || observed.network != network
+    {
+        return Err(invalid(
+            "Deposit settlement requires matching fresh reconciliation",
+        ));
+    }
+    let payment = observed
+        .payment
+        .ok_or_else(|| invalid("Deposit receipt missing"))?;
+    if payment.id != transfer_id
+        || payment.status != PaymentStatus::Completed
+        || payment.payment_type != PaymentType::Receive
+        || payment.method != PaymentMethod::Deposit
+        || payment.conversion_details.is_some()
+        || !matches!(&payment.details, Some(PaymentDetails::Deposit { tx_id, vout, .. })
+            if tx_id == &request.txid && *vout == request.vout)
+    {
+        return Err(invalid(
+            "Fresh deposit settlement has an incompatible payment projection",
+        ));
+    }
+    economics(&payment, &request)?;
+    require_unchanged(backend, &key, &expected).await?;
+    backend.apply_payment(payment.clone()).await?;
+    backend.delete_deposit(&request.txid, request.vout).await?;
+    // The attempt marker is never deleted or weakened, including after success.
+    Ok(ClaimDepositResponse {
+        outcome: ClaimDepositOutcome::Settled { payment },
+    })
+}
+
+pub(super) async fn continue_claim(
+    sdk: &BreezSdk,
+    request: MatureDepositClaimRequest,
+    identity: String,
+    network: Network,
+) -> Result<ClaimDepositResponse, SdkError> {
+    continue_with(sdk, request, identity, network).await
+}
+
+#[cfg(test)]
+mod tests;
