new file mode 100644
index 0000000000000000000000000000000000000000..d757614b8f6cb9288461ed4a79314807869417ee
--- /dev/null
+++ b/crates/spark/src/services/transfer/strict_observation.rs
@@ -0,0 +1,295 @@
+//! Fail-closed operator reads for explicit observation and claim validation.
+//! Ordinary synchronization retains its existing compatibility behavior.
+
+use super::TransferService;
+use crate::Network;
+use crate::operator::rpc::spark as proto;
+use crate::services::models::leaf_output_value;
+use crate::services::{ServiceError, Transfer, TransferId};
+use crate::utils::paging::{PagingFilter, PagingResult};
+use bitcoin::consensus::deserialize;
+use bitcoin::secp256k1::PublicKey;
+use std::collections::HashSet;
+use uuid::Uuid;
+
+const MAX_MONEY: u64 = 2_100_000_000_000_000;
+// A local observation resource bound, not a claim about the protocol maximum.
+const MAX_OBSERVATION_LEAVES: usize = 1000;
+
+fn invalid(message: &str) -> ServiceError {
+    ServiceError::ValidationError(message.to_owned())
+}
+
+fn canonical_id(value: &str) -> Result<(), ServiceError> {
+    let id = Uuid::parse_str(value).map_err(|_| invalid("Invalid observation identifier"))?;
+    if id.is_nil() || id.to_string() != value {
+        return Err(invalid("Noncanonical observation identifier"));
+    }
+    Ok(())
+}
+
+fn canonical_key(value: &[u8]) -> Result<PublicKey, ServiceError> {
+    let key = PublicKey::from_slice(value).map_err(|_| invalid("Invalid participant identity"))?;
+    if key.serialize().as_slice() != value {
+        return Err(invalid("Noncanonical participant identity"));
+    }
+    Ok(key)
+}
+
+fn query_parameters(paging: &PagingFilter, ids: &[TransferId]) -> Result<(i64, i64), ServiceError> {
+    if !(1..=100).contains(&paging.limit)
+        || paging.offset > i64::MAX as u64 - paging.limit
+        || ids.len() > 1
+        || (!ids.is_empty() && (paging.offset != 0 || paging.limit < 2))
+    {
+        return Err(invalid("Strict transfer query exceeds its explicit bounds"));
+    }
+    for id in ids {
+        canonical_id(&id.to_string())?;
+    }
+    Ok((paging.limit as i64, paging.offset as i64))
+}
+
+fn strict_continuation(
+    raw_offset: i64,
+    paging: &PagingFilter,
+    count: usize,
+) -> Result<Option<PagingFilter>, ServiceError> {
+    query_parameters(paging, &[])?;
+    if count as u64 > paging.limit {
+        return Err(invalid("Transfer response exceeds requested page size"));
+    }
+    // Pinned SDK proto leaves this sentinel undocumented. The separately pinned
+    // public operator implementation uses -1 for exhaustion and advances by its
+    // selected ID count when that count equals limit. It can render fewer rows
+    // after concurrent deletion. Preserve the raw cursor, never manufacture it
+    // from rendered rows. An incompatible provider response stays unresolved.
+    if raw_offset == -1 {
+        return Ok(None);
+    }
+    let offset = u64::try_from(raw_offset).map_err(|_| invalid("Invalid transfer continuation"))?;
+    if count == 0 || offset != paging.offset + paging.limit {
+        return Err(invalid(
+            "Transfer continuation is empty, stalled or skips a page",
+        ));
+    }
+    Ok(Some(PagingFilter {
+        offset,
+        ..paging.clone()
+    }))
+}
+
+/// Validate raw facts that the ordinary Transfer conversion does not retain.
+/// This supports only one complete sender/receiver edge, not general MIMO.
+#[allow(deprecated)]
+pub(crate) fn validate_observation_transfer(
+    raw: &proto::Transfer,
+    expected_network: Network,
+) -> Result<(), ServiceError> {
+    canonical_id(&raw.id)?;
+    if raw.network != expected_network.to_proto_network() as i32 {
+        return Err(invalid(
+            "Operator transfer network differs from this wallet",
+        ));
+    }
+    let status = proto::TransferStatus::try_from(raw.status)
+        .map_err(|_| invalid("Unknown operator transfer status"))?;
+    if !matches!(
+        proto::TransferType::try_from(raw.r#type),
+        Ok(proto::TransferType::Transfer
+            | proto::TransferType::PreimageSwap
+            | proto::TransferType::UtxoSwap
+            | proto::TransferType::CooperativeExit)
+    ) {
+        return Err(invalid("Unsupported observed transfer protocol"));
+    }
+    let ([sender], [receiver]) = (raw.senders.as_slice(), raw.receivers.as_slice()) else {
+        return Err(invalid(
+            "Observation requires exactly one sender and one receiver",
+        ));
+    };
+    canonical_id(&sender.id)?;
+    canonical_id(&receiver.id)?;
+    canonical_key(&sender.identity_public_key)?;
+    canonical_key(&receiver.identity_public_key)?;
+    if sender.identity_public_key != raw.sender_identity_public_key
+        || receiver.identity_public_key != raw.receiver_identity_public_key
+        || receiver.amount_sats == 0
+        || receiver.amount_sats > MAX_MONEY
+        || receiver.amount_sats != raw.total_value
+    {
+        return Err(invalid(
+            "Authoritative transfer participants or amount disagree",
+        ));
+    }
+    validate_receiver_status(status, receiver.status)?;
+    if raw.leaves.is_empty() || raw.leaves.len() > MAX_OBSERVATION_LEAVES {
+        return Err(invalid("Observation requires a complete bounded leaf set"));
+    }
+    let mut leaf_ids = HashSet::new();
+    let mut total = 0u64;
+    for assigned in &raw.leaves {
+        if assigned.transfer_sender_id != sender.id || assigned.transfer_receiver_id != receiver.id
+        {
+            return Err(invalid("Transfer leaf belongs to a different participant"));
+        }
+        let leaf = assigned
+            .leaf
+            .as_ref()
+            .ok_or_else(|| invalid("Transfer leaf is missing"))?;
+        canonical_id(&leaf.id)?;
+        if !leaf_ids.insert(leaf.id.as_str())
+            || leaf.network != raw.network
+            || leaf.value == 0
+            || leaf.value > MAX_MONEY
+        {
+            return Err(invalid(
+                "Transfer leaf identity, network or amount is inconsistent",
+            ));
+        }
+        let key = canonical_key(&leaf.verifying_public_key)?;
+        let node_tx = deserialize(&leaf.node_tx)
+            .map_err(|_| invalid("Observed transfer leaf transaction is malformed"))?;
+        if leaf_output_value(&node_tx, &key) != Some(leaf.value) {
+            return Err(invalid(
+                "Observed transfer leaf value is not backed by its output",
+            ));
+        }
+        total = total
+            .checked_add(leaf.value)
+            .ok_or_else(|| invalid("Observed transfer leaf amount overflows"))?;
+    }
+    if total != receiver.amount_sats {
+        return Err(invalid("Assigned leaf sum differs from receiver credit"));
+    }
+    Ok(())
+}
+
+fn validate_receiver_status(
+    status: proto::TransferStatus,
+    receiver: i32,
+) -> Result<(), ServiceError> {
+    // Matches both maps in buildonspark/spark@0b3a32a's
+    // spark/so/mimo/receiver_axis.go. These are V2 single-receiver semantics;
+    // accepting a V3 aggregate in place of an individual receiver is unsupported.
+    use proto::{TransferReceiverStatus as R, TransferStatus as T};
+    let expected = match status {
+        T::SenderInitiated
+        | T::SenderKeyTweakPending
+        | T::SenderInitiatedCoordinator
+        | T::ApplyingSenderKeyTweak => R::Initiated,
+        T::SenderKeyTweaked => R::ClaimPending,
+        T::ReceiverKeyTweaked => R::KeyTweaked,
+        T::ReceiverKeyTweakLocked => R::KeyTweakLocked,
+        T::ReceiverKeyTweakApplied => R::KeyTweakApplied,
+        T::ReceiverRefundSigned => R::RefundSigned,
+        T::Completed => R::Completed,
+        T::Expired | T::Returned => R::Cancelled,
+    };
+    if receiver != expected as i32 {
+        return Err(invalid(
+            "Receiver status differs from the supported single-receiver transfer",
+        ));
+    }
+    Ok(())
+}
+
+#[allow(deprecated)]
+fn strict_page(
+    response: proto::QueryTransfersResponse,
+    paging: &PagingFilter,
+    ids: &[TransferId],
+    identity: PublicKey,
+    network: Network,
+) -> Result<PagingResult<Transfer>, ServiceError> {
+    query_parameters(paging, ids)?;
+    if !ids.is_empty() && response.offset != -1 {
+        return Err(invalid(
+            "Exact by-ID transfer evidence is not a terminal set",
+        ));
+    }
+    let next = strict_continuation(response.offset, paging, response.transfers.len())?;
+    let mut seen = HashSet::new();
+    let identity = identity.serialize();
+    let items = response
+        .transfers
+        .into_iter()
+        .map(|raw| {
+            validate_observation_transfer(&raw, network)?;
+            if !seen.insert(raw.id.clone())
+                || (!ids.is_empty() && !ids.iter().any(|id| id.to_string() == raw.id))
+                || (raw.sender_identity_public_key != identity
+                    && raw.receiver_identity_public_key != identity)
+            {
+                return Err(invalid(
+                    "Transfer page contains duplicate, foreign or unrequested evidence",
+                ));
+            }
+            // Every conversion is required. Never drop a malformed row beside a
+            // valid one and accidentally turn an ambiguous response into one match.
+            Transfer::try_from(raw)
+        })
+        .collect::<Result<Vec<_>, _>>()?;
+    Ok(PagingResult { items, next })
+}
+
+impl TransferService {
+    /// One explicit page with strict raw correlation. No claim, signing, sync,
+    /// or retry. This is not an atomic provider snapshot or non-execution proof.
+    pub async fn query_transfers_strict(
+        &self,
+        transfer_ids: &[TransferId],
+        paging: PagingFilter,
+    ) -> Result<PagingResult<Transfer>, ServiceError> {
+        let (limit, offset) = query_parameters(&paging, transfer_ids)?;
+        let identity = self.spark_signer.get_identity_public_key().await?;
+        if !transfer_ids.is_empty() {
+            // The pinned public operator receiver-projects QueryAllTransfers,
+            // including exact-ID filters. Its QueryTransfersById path marshals
+            // without projection, so final validation cannot rely on the newer
+            // include_all_participants flag being understood by deployment.
+            let response = self
+                .operator_pool
+                .get_coordinator()
+                .client
+                .query_transfers_by_id(proto::QueryTransfersByIdRequest {
+                    transfer_ids: transfer_ids.iter().map(ToString::to_string).collect(),
+                    network: self.network.to_proto_network() as i32,
+                })
+                .await?;
+            return strict_page(response, &paging, transfer_ids, identity, self.network);
+        }
+        let order: proto::Order = paging.order.into();
+        let response = self
+            .operator_pool
+            .get_coordinator()
+            .client
+            .query_all_transfers(proto::TransferFilter {
+                order: order as i32,
+                transfer_ids: transfer_ids.iter().map(ToString::to_string).collect(),
+                participant: Some(
+                    proto::transfer_filter::Participant::SenderOrReceiverIdentityPublicKey(
+                        identity.serialize().to_vec(),
+                    ),
+                ),
+                network: self.network.to_proto_network() as i32,
+                limit,
+                offset,
+                types: vec![
+                    proto::TransferType::Transfer as i32,
+                    proto::TransferType::PreimageSwap as i32,
+                    proto::TransferType::CooperativeExit as i32,
+                    proto::TransferType::UtxoSwap as i32,
+                ],
+                include_all_participants: true,
+                ..Default::default()
+            })
+            .await?;
+        strict_page(response, &paging, transfer_ids, identity, self.network)
+    }
+}
+
+#[cfg(test)]
+mod tests;
+#[cfg(test)]
+pub(crate) use tests::observation_transfer_test_fixture;
