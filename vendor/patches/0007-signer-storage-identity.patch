+}
+
+#[macros::test_all]
+fn strict_transfer_complete_single_participant_evidence_survives_raw_and_typed_checks() {
+    for network in [
+        Network::Mainnet,
+        Network::Regtest,
+        Network::Testnet,
+        Network::Signet,
+    ] {
+        let raw = observation_transfer_test_fixture(network);
+        validate_observation_transfer(&raw, network).unwrap();
+        let typed = Transfer::try_from(raw).unwrap();
+        assert_eq!(typed.total_value, 990);
+        assert_eq!(typed.leaves.len(), 1);
+    }
+    let observed = decode(
+        vec![observation_transfer_test_fixture(Network::Regtest)],
+        -1,
+    )
+    .unwrap();
+    assert_eq!(observed.items.len(), 1);
+    assert!(observed.next.is_none());
+}
+
+#[macros::test_all]
+fn strict_transfer_raw_cursor_is_never_normalized_into_completion_or_a_different_page() {
+    let raw = observation_transfer_test_fixture(Network::Regtest);
+    for cursor in [i64::MIN, -2, 0, 1, 3, 100] {
+        assert!(
+            decode(vec![raw.clone()], cursor).is_err(),
+            "cursor {cursor}"
+        );
+    }
+    let next = decode(vec![raw], 2).unwrap().next.unwrap();
+    assert_eq!(next.offset, 2);
+    assert_eq!(next.limit, 2);
+    assert_eq!(next.order, paging(0).order);
+    for cursor in [0, 1, 10, 11, 13] {
+        assert!(strict_continuation(cursor, &paging(10), 1).is_err());
+    }
+    assert_eq!(
+        strict_continuation(12, &paging(10), 1)
+            .unwrap()
+            .unwrap()
+            .offset,
+        12
+    );
+    assert!(strict_continuation(12, &paging(10), 0).is_err());
+    assert!(decode(vec![], -1).unwrap().next.is_none());
