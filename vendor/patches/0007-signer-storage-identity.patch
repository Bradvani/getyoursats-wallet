+        output: vec![TxOut {
+            value: Amount::from_sat(990),
+            script_pubkey: ScriptBuf::new_p2tr(&secp, verifying.x_only_public_key().0, None),
+        }],
+    };
+    let leaf = proto::TreeNode {
+        id: "00000000-0000-4000-8000-000000000021".to_owned(),
