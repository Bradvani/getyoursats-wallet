+//! Actual WASM-to-JavaScript ABI controls. No wallet, provider or adapter is
+//! constructed; the JavaScript objects below are disconnected public fixtures.
+use crate::persist::{Storage, WasmStorage};
+use breez_sdk_spark::Storage as _;
+use js_sys::{Function, Object, Reflect};
+use wasm_bindgen::{JsCast, JsValue};
+use wasm_bindgen_test::*;
+
+fn fixture(body: Option<&str>) -> (WasmStorage, Object) {
+    let object = Object::new();
+    Reflect::set(&object, &"calls".into(), &0.into()).unwrap();
+    Reflect::set(&object, &"fallbacks".into(), &0.into()).unwrap();
+    if let Some(body) = body {
+        Reflect::set(
+            &object,
+            &"compareAndSwapCachedItem".into(),
+            &Function::new_with_args("key, expected, value", body),
+        )
+        .unwrap();
+    }
+    Reflect::set(
+        &object,
+        &"getCachedItem".into(),
+        &Function::new_no_args("this.fallbacks += 1; return Promise.resolve(null);"),
+    )
+    .unwrap();
+    Reflect::set(
+        &object,
+        &"setCachedItem".into(),
+        &Function::new_no_args("this.fallbacks += 1; return Promise.resolve();"),
+    )
+    .unwrap();
+    let storage: Storage = object.clone().unchecked_into();
+    (WasmStorage { storage }, object)
+}
+
+#[wasm_bindgen_test]
+async fn storage_cas_bridge_preserves_null_and_exact_strings() {
+    let (storage, object) = fixture(Some(
+        "this.calls += 1; this.args = [key, expected, value]; return Promise.resolve(true);",
+    ));
+    assert!(
+        storage
+            .compare_and_swap_cached_item("public-key".into(), None, "submitted".into())
+            .await
+            .unwrap()
+    );
+    let arguments = js_sys::Array::from(&Reflect::get(&object, &"args".into()).unwrap());
+    assert!(arguments.get(1).is_null());
+    assert_eq!(arguments.get(0).as_string().as_deref(), Some("public-key"));
+    assert_eq!(arguments.get(2).as_string().as_deref(), Some("submitted"));
+    let original = "{ \"phase\": \"submitted\" }\n";
+    assert!(
+        storage
+            .compare_and_swap_cached_item(
+                "public-key".into(),
+                Some(original.into()),
+                "receiving".into()
+            )
+            .await
+            .unwrap()
+    );
+    let arguments = js_sys::Array::from(&Reflect::get(&object, &"args".into()).unwrap());
+    assert_eq!(arguments.get(1).as_string().as_deref(), Some(original));
+    assert_eq!(
+        Reflect::get(&object, &"fallbacks".into()).unwrap().as_f64(),
+        Some(0.0)
+    );
+}
+
+#[wasm_bindgen_test]
+async fn storage_cas_bridge_missing_method_has_no_get_set_fallback() {
+    let (storage, object) = fixture(None);
+    assert!(
+        storage
+            .compare_and_swap_cached_item("public-key".into(), None, "submitted".into())
+            .await
+            .is_err()
+    );
+    assert_eq!(
+        Reflect::get(&object, &"fallbacks".into()).unwrap().as_f64(),
+        Some(0.0)
+    );
+}
+
+#[wasm_bindgen_test]
+async fn storage_cas_bridge_preserves_false_mismatch() {
+    let (storage, _) = fixture(Some("return Promise.resolve(false);"));
+    assert!(
+        !storage
+            .compare_and_swap_cached_item("public-key".into(), None, "submitted".into())
+            .await
+            .unwrap()
+    );
+}
+
+#[wasm_bindgen_test]
+async fn storage_cas_bridge_rejects_nonboolean_commit_values() {
+    for expression in ["undefined", "null", "0", "1", "'true'", "{}", "[]"] {
+        let (storage, _) = fixture(Some(&format!("return Promise.resolve({expression});")));
+        assert!(
+            storage
+                .compare_and_swap_cached_item("public-key".into(), None, "submitted".into())
+                .await
+                .is_err(),
+            "{expression}"
+        );
+    }
+}
+
+#[wasm_bindgen_test]
+async fn storage_cas_bridge_rejects_nonpromise_and_failed_acknowledgements() {
+    for body in [
+        "return true;",
+        "throw new Error('public synchronous fault');",
+        "return Promise.reject(new Error('public uncertain commit'));",
+    ] {
+        let (storage, _) = fixture(Some(body));
+        assert!(
+            storage
+                .compare_and_swap_cached_item("public-key".into(), None, "submitted".into())
+                .await
+                .is_err(),
+            "{body}"
+        );
+    }
+}
+
+#[wasm_bindgen_test]
+async fn storage_cas_bridge_malformed_read_is_not_absence() {
+    for expression in ["0", "false", "{}", "[]"] {
+        let (storage, object) = fixture(None);
+        Reflect::set(
+            &object,
+            &"getCachedItem".into(),
+            &Function::new_no_args(&format!("return Promise.resolve({expression});")),
+        )
+        .unwrap();
+        assert!(
+            storage.get_cached_item("public-key".into()).await.is_err(),
+            "{expression}"
+        );
+    }
+}
