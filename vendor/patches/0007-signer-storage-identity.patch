+++ b/crates/spark-wallet/src/wallet/deposit_observation.rs
@@ -0,0 +1,414 @@
+//! Bounded deposit observation without claims, signing, or lossy enrichment maps.
+
+use super::*;
+use spark::ssp::{BitcoinNetwork, CurrencyAmount, CurrencyUnit};
+
+fn invalid(message: &str) -> SparkWalletError {
+    SparkWalletError::Generic(message.to_owned())
+}
+
+fn exact_sats(amount: &CurrencyAmount) -> Result<u64, SparkWalletError> {
+    match amount.original_unit {
+        CurrencyUnit::Satoshi => Ok(amount.original_value),
+        CurrencyUnit::Millisatoshi if amount.original_value % 1000 == 0 => {
+            Ok(amount.original_value / 1000)
+        }
+        _ => Err(invalid(
+            "Deposit observation contains an inexact currency amount",
+        )),
+    }
+}
+
+fn is_receiving_deposit(transfer: &Transfer, ours: PublicKey, ssp: PublicKey) -> bool {
+    transfer.transfer_type == TransferType::UtxoSwap
+        && transfer.receiver_identity_public_key == ours
+        && transfer.sender_identity_public_key == ssp
+}
+
+fn validate_page(
+    page: &PagingResult<Transfer>,
+    paging: &PagingFilter,
+    ids: &[TransferId],
+) -> Result<(), SparkWalletError> {
+    if paging.limit == 0
+        || paging.limit > 100
+        || paging.offset > i64::MAX as u64 - paging.limit
+        || ids.len() > 1
+        || page.items.len() as u64 > paging.limit
+    {
+        return Err(invalid("Deposit observation page is outside its bound"));
+    }
+    if let Some(next) = &page.next {
+        if page.items.is_empty()
+            || next.offset != paging.offset + paging.limit
+            || next.limit != paging.limit
+            || next.order != paging.order
+        {
+            return Err(invalid(
+                "Deposit observation page continuation is inconsistent",
+            ));
+        }
+    }
+    let mut seen = HashSet::new();
+    for transfer in &page.items {
+        if !seen.insert(transfer.id.to_string()) || (!ids.is_empty() && !ids.contains(&transfer.id))
+        {
+            return Err(invalid(
+                "Deposit observation contains duplicate or unrequested transfers",
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn project_page(
+    page: PagingResult<Transfer>,
+    provider_rows: Vec<SspTransfer>,
+    ours: PublicKey,
+    ssp: PublicKey,
+    network: BitcoinNetwork,
+) -> Result<PagingResult<WalletTransfer>, SparkWalletError> {
+    let expected: HashMap<_, _> = page
+        .items
+        .iter()
+        .filter(|transfer| is_receiving_deposit(transfer, ours, ssp))
+        .map(|transfer| (transfer.id.to_string(), transfer.total_value))
+        .collect();
+    let mut provider = HashMap::new();
+    for row in provider_rows {
+        let id = row
+            .spark_id
+            .as_deref()
+            .ok_or_else(|| invalid("Deposit provider observation is missing its transfer id"))?;
+        let Some(value) = expected.get(id) else {
+            return Err(invalid(
+                "Deposit provider observation contains an unrequested transfer",
+            ));
+        };
+        let Some(SspUserRequest::ClaimStaticDeposit(deposit)) = &row.user_request else {
+            return Err(invalid("Deposit provider observation is incomplete"));
+        };
+        // Check original funding/credit units before Payment conversion, which
+        // otherwise rounds currency amounts and saturates a negative fee to 0.
+        // This read is also the one-shot claim's pre-receive validation boundary.
+        let deposited = exact_sats(&deposit.deposit_amount)?;
+        let credited = exact_sats(&deposit.credit_amount)?;
+        if deposit.network != network
+            || deposit.bitcoin_network != network
+            || deposit.id.is_empty()
+            || deposit.id.len() > 512
+            || deposit.transfer_spark_id.as_deref() != Some(id)
+            || deposited == 0
+            || deposited > 2_100_000_000_000_000
+            || credited == 0
+            || credited > deposited
+            || exact_sats(&row.total_amount)? != *value
+            || credited != *value
+            || provider.insert(id.to_owned(), row).is_some()
+        {
+            return Err(invalid(
+                "Deposit provider correlation is ambiguous or inconsistent",
+            ));
+        }
+    }
+    if provider.len() != expected.len() {
+        return Err(invalid(
+            "Deposit provider observation omitted requested deposit metadata",
+        ));
+    }
+    Ok(page.map(|transfer| {
+        let provider_row = provider.get(&transfer.id.to_string()).cloned();
+        WalletTransfer::from_transfer(transfer, provider_row, None, ours, ssp)
+    }))
+}
+
+impl SparkWallet {
+    /// Read one explicit bounded operator page and preserve exact deposit/SSP
+    /// correlation before projection. Never claims, signs, resumes, or syncs.
+    /// Non-deposit transfers remain in the page so pagination counts stay exact.
+    pub async fn observe_deposit_transfers(
+        &self,
+        request: ListTransfersRequest,
+    ) -> Result<PagingResult<WalletTransfer>, SparkWalletError> {
+        let paging = request
+            .paging
+            .ok_or_else(|| invalid("Deposit observation requires explicit pagination"))?;
+        validate_page(
+            &PagingResult::complete(Vec::new()),
+            &paging,
+            &request.transfer_ids,
+        )?;
+        let transfers = self
+            .transfer_service
+            .query_transfers_strict(&request.transfer_ids, paging.clone())
+            .await?;
+        validate_page(&transfers, &paging, &request.transfer_ids)?;
+        let ours = self.identity_public_key;
+        let ssp = self.ssp_client.identity_public_key();
+        let ids: Vec<_> = transfers
+            .items
+            .iter()
+            .filter(|transfer| is_receiving_deposit(transfer, ours, ssp))
+            .map(|transfer| transfer.id.to_string())
+            .collect();
+        let provider = if ids.is_empty() {
+            Vec::new()
+        } else {
+            self.ssp_client.get_transfers(ids).await?
+        };
+        project_page(transfers, provider, ours, ssp, self.config.network.into())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use spark::ssp::{ClaimStaticDepositInfo, ClaimStaticDepositStatus};
+    use spark::utils::paging::Order;
+
+    fn keys() -> (PublicKey, PublicKey) {
+        let key = |fill| {
+            let mut bytes = [fill; 33];
+            bytes[0] = 2;
+            PublicKey::from_slice(&bytes).unwrap()
+        };
+        (key(1), key(2))
+    }
+
+    fn fixture() -> (Transfer, SspTransfer) {
+        let (ours, ssp) = keys();
+        let amount = |value| CurrencyAmount {
+            original_value: value,
+            ..Default::default()
+        };
+        let id = TransferId::from_str("00000000-0000-4000-8000-000000000001").unwrap();
+        let transfer = Transfer {
+            id: id.clone(),
+            sender_identity_public_key: ssp,
+            receiver_identity_public_key: ours,
+            status: TransferStatus::Completed,
+            total_value: 990,
+            expiry_time: None,
+            leaves: Vec::new(),
+            created_time: None,
+            updated_time: None,
+            transfer_type: TransferType::UtxoSwap,
+            spark_invoice: None,
+        };
+        let provider = SspTransfer {
+            total_amount: amount(990),
+            spark_id: Some(id.to_string()),
+            user_request: Some(SspUserRequest::ClaimStaticDeposit(ClaimStaticDepositInfo {
+                id: "deposit-request".to_owned(),
+                created_at: std::time::SystemTime::UNIX_EPOCH.into(),
+                updated_at: std::time::SystemTime::UNIX_EPOCH.into(),
+                network: BitcoinNetwork::Regtest,
+                deposit_amount: amount(1000),
+                deposit_status: ClaimStaticDepositStatus::TransferCompleted,
+                credit_amount: amount(990),
+                max_fee: amount(10),
+                transaction_id: "a".repeat(64),
+                output_index: 0,
+                bitcoin_network: BitcoinNetwork::Regtest,
+                transfer_spark_id: Some(id.to_string()),
+            })),
+        };
+        (transfer, provider)
+    }
+
+    fn project(
+        transfers: Vec<Transfer>,
+        rows: Vec<SspTransfer>,
+    ) -> Result<PagingResult<WalletTransfer>, SparkWalletError> {
+        let (ours, ssp) = keys();
+        project_page(
+            PagingResult::complete(transfers),
+            rows,
+            ours,
+            ssp,
+            BitcoinNetwork::Regtest,
+        )
+    }
+
+    #[test]
+    fn deposit_observation_preserves_exact_provider_receipt() {
+        let (transfer, provider) = fixture();
+        let result = project(vec![transfer], vec![provider]).unwrap();
+        assert_eq!(result.items.len(), 1);
+        assert!(matches!(
+            result.items[0].user_request,
+            Some(SspUserRequest::ClaimStaticDeposit(_))
+        ));
+    }
+
+    #[test]
+    fn deposit_observation_rejects_duplicate_provider_rows_before_map_projection() {
+        let (transfer, provider) = fixture();
+        assert!(project(vec![transfer], vec![provider.clone(), provider]).is_err());
+    }
+
+    #[test]
+    fn deposit_observation_rejects_foreign_missing_or_incomplete_provider_rows() {
+        let (transfer, provider) = fixture();
+        assert!(project(vec![transfer.clone()], Vec::new()).is_err());
+        for variant in 0..3 {
+            let mut row = provider.clone();
+            match variant {
+                0 => row.spark_id = None,
+                1 => row.spark_id = Some("00000000-0000-4000-8000-000000000002".to_owned()),
+                _ => row.user_request = None,
+            }
+            assert!(project(vec![transfer.clone()], vec![row]).is_err());
+        }
+    }
+
+    #[test]
+    fn deposit_observation_rejects_nested_id_network_and_credit_conflicts() {
+        let (transfer, provider) = fixture();
+        for variant in 0..6 {
+            let mut row = provider.clone();
+            let Some(SspUserRequest::ClaimStaticDeposit(deposit)) = &mut row.user_request else {
+                panic!()
+            };
+            match variant {
+                0 => deposit.transfer_spark_id = None,
+                1 => deposit.transfer_spark_id = Some("other".to_owned()),
+                2 => deposit.network = BitcoinNetwork::Mainnet,
+                3 => deposit.bitcoin_network = BitcoinNetwork::Mainnet,
+                4 => deposit.credit_amount.original_value = 991,
+                _ => row.total_amount.original_value = 991,
+            }
+            assert!(project(vec![transfer.clone()], vec![row]).is_err());
+        }
+    }
+
+    #[test]
+    fn deposit_observation_never_rounds_fractional_satoshis() {
+        let amount = |value| CurrencyAmount {
+            original_value: value,
+            original_unit: CurrencyUnit::Millisatoshi,
+            ..Default::default()
+        };
+        assert_eq!(exact_sats(&amount(1000)).unwrap(), 1);
+        assert!(exact_sats(&amount(1001)).is_err());
+        assert!(
+            exact_sats(&CurrencyAmount {
+                original_unit: CurrencyUnit::Usd,
+                ..Default::default()
+            })
+            .is_err()
+        );
+    }
+
+    #[test]
+    fn deposit_observation_pre_receive_rejects_credit_above_funding_before_fee_saturation() {
+        let (mut transfer, mut provider) = fixture();
+        transfer.total_value = 1000;
+        provider.total_amount.original_value = 1000;
+        let Some(SspUserRequest::ClaimStaticDeposit(deposit)) = &mut provider.user_request else {
+            panic!()
+        };
+        deposit.credit_amount.original_value = 1000;
+        deposit.deposit_amount.original_value = 999;
+        // The legacy Payment projection would report credit1000 + fee0,
+        // apparently matching an approval for1000 despite contradictory funding.
+        assert_eq!(999u64.saturating_sub(1000), 0);
+        assert!(project(vec![transfer], vec![provider]).is_err());
+    }
+
+    #[test]
+    fn deposit_observation_pre_receive_requires_exact_bounded_original_funding() {
+        for (unit, amount) in [
+            (CurrencyUnit::Satoshi, 0),
+            (CurrencyUnit::Satoshi, 2_100_000_000_000_001),
+            (CurrencyUnit::Millisatoshi, 1_000_001),
+            (CurrencyUnit::Usd, 1000),
+        ] {
+            let (transfer, mut row) = fixture();
+            let Some(SspUserRequest::ClaimStaticDeposit(deposit)) = &mut row.user_request else {
+                panic!()
+            };
+            deposit.deposit_amount.original_unit = unit;
+            deposit.deposit_amount.original_value = amount;
+            assert!(project(vec![transfer], vec![row]).is_err());
+        }
+        let (transfer, mut row) = fixture();
+        let Some(SspUserRequest::ClaimStaticDeposit(deposit)) = &mut row.user_request else {
+            panic!()
+        };
+        deposit.deposit_amount.original_unit = CurrencyUnit::Millisatoshi;
+        deposit.deposit_amount.original_value = 1_000_000;
+        assert!(project(vec![transfer], vec![row]).is_ok());
+    }
+
+    #[test]
+    fn deposit_observation_preserves_non_deposit_pagination_items_without_enrichment() {
+        let (mut transfer, _) = fixture();
+        transfer.transfer_type = TransferType::Transfer;
+        let result = project(vec![transfer], Vec::new()).unwrap();
+        assert_eq!(result.items.len(), 1);
+        assert!(result.items[0].user_request.is_none());
+    }
+
+    #[test]
+    fn deposit_observation_rejects_operator_duplicates_and_foreign_exact_ids() {
+        let (transfer, _) = fixture();
+        let paging = PagingFilter::default();
+        assert!(
+            validate_page(
+                &PagingResult::complete(vec![transfer.clone(), transfer.clone()]),
+                &paging,
+                &[]
+            )
+            .is_err()
+        );
+        assert!(
+            validate_page(
+                &PagingResult::complete(vec![transfer]),
+                &paging,
+                &[TransferId::from_str("00000000-0000-4000-8000-000000000002").unwrap()]
+            )
+            .is_err()
+        );
+    }
+
+    #[test]
+    fn deposit_observation_rejects_inconsistent_or_empty_continuation() {
+        let (transfer, _) = fixture();
+        let paging = PagingFilter::default();
+        assert!(
+            validate_page(
+                &PagingResult {
+                    items: Vec::new(),
+                    next: Some(paging.next())
+                },
+                &paging,
+                &[]
+            )
+            .is_err()
+        );
+        for next in [
+            paging.clone(),
+            PagingFilter {
+                limit: 50,
+                ..paging.next()
+            },
+            PagingFilter {
+                order: spark::utils::paging::Order::Ascending,
+                ..paging.next()
+            },
+        ] {
+            assert!(
+                validate_page(
+                    &PagingResult {
+                        items: vec![transfer.clone()],
+                        next: Some(next)
+                    },
+                    &paging,
+                    &[]
+                )
+                .is_err()
+            );
+        }
+    }
+}
