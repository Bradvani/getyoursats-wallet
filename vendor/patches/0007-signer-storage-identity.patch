+    // Serde accepts positional representations of these structs. A correct
+    // content hash alone must not make that alternate schema acceptable.
+    let array = serde_json::json!([
+        b.version,
+        b.intent,
+        b.ssp_identity_pubkey,
+        b.ssp_request_id,
+        b.payment_hash,
+        b.credit_sats,
+        b.fee_sats,
+        b.invoice_expires_at,
+        b.htlc_expires_at
+    ])
+    .to_string();
+    assert!(serde_json::from_str::<Binding>(&array).is_ok());
+    let mut nested = serde_json::to_value(&b).unwrap();
+    nested["intent"] = serde_json::json!([
+        b.intent.payment_id,
+        b.intent.identity_pubkey,
+        b.intent.network,
+        b.intent.invoice,
+        b.intent.invoice_amount_sats,
+        b.intent.max_fee_sats,
+        b.intent.minimum_credit_sats
+    ]);
+    assert!(serde_json::from_value::<Binding>(nested.clone()).is_ok());
+    for alternate in [
+        array,
+        nested.to_string(),
+        encoded.replacen("\"version\":1", "\"version\":2", 1),
+        encoded.replacen("{", "{\"unexpected\":true,", 1),
+        encoded.replacen("{", "{\"version\":1,", 1),
+        format!("{encoded} "),
+    ] {
+        assert!(decode_binding(&alternate, &digest(&alternate), &intent).is_err());
+    }
+}
+
+#[macros::async_test_all]
+async fn incoming_lightning_fee_and_credit_limits_are_independent_and_inclusive() {
+    for (credit, max_fee, minimum, accepted) in [
+        (11, 0, 11, true),
+        (10, 1, 10, true),
+        (9, 2, 9, true),
+        (10, 0, 9, false),
+        (10, 2, 11, false),
+        (8, 3, 9, false),
+        (12, 2, 9, false),
+    ] {
+        let (io, mut r) = fixture();
+        r.max_fee_sats = max_fee;
+        r.minimum_credit_sats = minimum;
+        {
+            let mut s = io.0.lock().unwrap();
+            let t = s.receipt.as_mut().unwrap();
+            t.total_value_sat = credit;
+            provider(t).transfer.as_mut().unwrap().total_amount = amount(credit);
+        }
+        let result = run(&io, r).await;
+        assert_eq!(
+            result.is_ok(),
+            accepted,
+            "credit={credit}, fee={max_fee}, minimum={minimum}"
+        );
+        if accepted {
+            let result = result.unwrap();
+            assert_eq!(result.outcome, Outcome::AwaitingPreimage);
+            assert_eq!(result.binding.unwrap().fee_sats, 11 - credit);
+        }
+    }
+}
diff --git a/crates/breez-sdk/core/src/sdk/mature_deposit.rs b/crates/breez-sdk/core/src/sdk/mature_deposit.rs
new file mode 100644
index 0000000000000000000000000000000000000000..496fa8c34e661d127ea01ecb27eee39325c6ab1d
--- /dev/null
+++ b/crates/breez-sdk/core/src/sdk/mature_deposit.rs
@@ -0,0 +1,737 @@
+//! Explicit one-shot mature BTC deposit claims. No early route or standing fee mandate.
+mod continuation;
+mod observation;
+use super::attempt_store::reserve_attempt;
+use crate::{
+    BreezSdk, ClaimDepositOutcome, ClaimDepositResponse, FetchClaimDepositQuoteRequest,
+    MatureDepositClaimRequest, Network, ObserveDepositClaimResponse, Payment, PaymentDetails,
+    PaymentMethod, PaymentStatus, PaymentType, SdkError,
+    utils::{deposit_chain_syncer::TxOutput, utxo_fetcher::CachedUtxoFetcher},
+};
+use bitcoin::Txid;
+use observation::StoredIntent as DepositAttempt;
+use spark_wallet::{
+    ListTransfersRequest, SspUserRequest, TransferDirection, TransferId, TransferStatus,
+    TransferType, WalletTransfer,
+};
+use std::str::FromStr;
+fn invalid(s: &str) -> SdkError {
+    SdkError::InvalidInput(s.into())
+}
+fn validate(
+    r: &MatureDepositClaimRequest,
+    identity: &str,
+    network: Network,
+    now: u64,
+) -> Result<(), SdkError> {
+    let txid = Txid::from_str(&r.txid).map_err(|_| invalid("Invalid deposit transaction"))?;
+    if txid.to_string() != r.txid
+        || r.identity_pubkey != identity
+        || r.network != network
+        || r.amount_sats == 0
+        || r.amount_sats > 2_100_000_000_000_000
+        || r.max_fee_sats >= r.amount_sats
+        || r.expires_at <= now
+        || r.expires_at > now.saturating_add(60)
+    {
+        return Err(invalid(
+            "Deposit claim identity, amount, fee, network or expiry is invalid",
+        ));
+    }
+    Ok(())
+}
+fn depth(confirmed: bool, height: Option<u32>, tip: u32, network: Network) -> Result<(), SdkError> {
+    let required = if network == Network::Regtest { 1 } else { 3 };
+    let h = height.ok_or_else(|| invalid("Confirmed deposit height is unavailable"))?;
+    if !confirmed || h > tip || u64::from(tip) - u64::from(h) + 1 < required {
+        return Err(invalid("Deposit is not mature on the current chain"));
+    }
+    Ok(())
+}
+fn credit(amount: u64, max_fee: u64, credited: u64) -> Result<(), SdkError> {
+    if credited == 0 || credited > amount || amount - credited > max_fee {
+        return Err(invalid("Deposit quote exceeds the authorized fee ceiling"));
+    }
+    Ok(())
+}
+fn receipt(
+    t: &WalletTransfer,
+    txid: &str,
+    vout: u32,
+    identity: &str,
+    network: Network,
+) -> Result<Payment, SdkError> {
+    if t.receiver_id.to_string() != identity
+        || t.direction != TransferDirection::Incoming
+        || t.transfer_type != TransferType::UtxoSwap
+        || t.htlc_preimage_request.is_some()
+    {
+        return Err(invalid("Transfer is not this wallet's deposit receipt"));
+    }
+    let Some(SspUserRequest::ClaimStaticDeposit(deposit)) = &t.user_request else {
+        return Err(invalid("Deposit has no authoritative SSP correlation"));
+    };
+    let transfer_id = t.id.to_string();
+    let expected_network = match network {
+        Network::Mainnet => spark_wallet::BitcoinNetwork::Mainnet,
+        Network::Regtest => spark_wallet::BitcoinNetwork::Regtest,
+        Network::Signet => spark_wallet::BitcoinNetwork::Signet,
+    };
+    let deposited = observation::exact_sats(&deposit.deposit_amount)?;
+    let credited = observation::exact_sats(&deposit.credit_amount)?;
+    if deposit.network != expected_network
+        || deposit.bitcoin_network != expected_network
+        || deposit.transaction_id != txid
+        || deposit.output_index != i64::from(vout)
+        || deposit.transfer_spark_id.as_deref() != Some(transfer_id.as_str())
+        || !t.is_ssp_transfer
+        || deposit.id.is_empty()
+        || deposit.id.len() > 512
+        || deposited == 0
+        || deposited > 2_100_000_000_000_000
+        || credited == 0
+        || credited > deposited
+        || credited != t.total_value_sat
+    {
+        return Err(invalid(
+            "Deposit SSP correlation differs from the operator transfer",
+        ));
+    }
+    let p = Payment::try_from(t.clone())?;
+    if p.payment_type != PaymentType::Receive
+        || p.method != PaymentMethod::Deposit
+        || p.conversion_details.is_some()
+        || !matches!(&p.details,Some(PaymentDetails::Deposit{tx_id,vout:output,..}) if tx_id==txid && *output==vout)
+    {
+        return Err(invalid(
+            "Deposit receipt does not match the authorized outpoint",
+        ));
+    }
+    Ok(p)
+}
+fn economics(p: &Payment, r: &MatureDepositClaimRequest) -> Result<(), SdkError> {
+    if p.amount == 0
+        || p.fees > u128::from(r.max_fee_sats)
+        || p.amount.checked_add(p.fees) != Some(u128::from(r.amount_sats))
+    {
+        return Err(invalid(
+            "Deposit settlement differs from its approved economics",
+        ));
+    }
+    Ok(())
+}
+fn require_receivable(t: &WalletTransfer) -> Result<(), SdkError> {
+    if t.status != TransferStatus::SenderKeyTweaked
+        || !matches!(&t.user_request,
+            Some(SspUserRequest::ClaimStaticDeposit(deposit))
+                if deposit.deposit_status == spark_wallet::ClaimStaticDepositStatus::TransferCreated)
+    {
+        return Err(invalid(
+            "Deposit transfer requires observation-only reconciliation",
+        ));
+    }
+    Ok(())
+}
+fn marker(txid: &str, vout: u32) -> String {
+    format!("gys:mature-deposit:v1:{txid}:{vout}")
+}
+
+impl DepositAttempt {
+    fn decode(
+        raw: &str,
+        txid: &str,
+        vout: u32,
+        identity: &str,
+        network: Network,
+    ) -> Result<Self, SdkError> {
+        let attempt = Self::parse(raw, txid, vout, identity, network)?;
+        if attempt.receiving_attempted == Some(false)
+            || (attempt.receiving_attempted.is_some() && attempt.transfer_id.is_none())
+        {
+            return Err(invalid(
+                "Deposit claim record has an invalid receiving boundary",
+            ));
+        }
+        Ok(attempt)
+    }
+    fn matches_authorization(&self, r: &MatureDepositClaimRequest) -> Result<(), SdkError> {
+        if self.txid != r.txid
+            || self.vout != r.vout
+            || self.identity != r.identity_pubkey
+            || self.network != format!("{:?}", r.network)
+            || self.amount != r.amount_sats
+            || self.max_fee != r.max_fee_sats
+        {
+            return Err(invalid(
+                "Deposit continuation changed the original economic intent",
+            ));
+        }
+        Ok(())
+    }
+    fn authorize_receiving(&mut self, id: &str) -> Result<(), SdkError> {
+        if self.receiving_attempted.is_some()
+            || self.transfer_id.as_deref().is_some_and(|old| old != id)
+        {
+            return Err(invalid(
+                "Deposit receiving was already attempted or its transfer changed",
+            ));
+        }
+        self.transfer_id = Some(id.to_owned());
+        self.receiving_attempted = Some(true);
+        Ok(())
+    }
+}
+#[cfg_attr(feature = "uniffi", uniffi::export(async_runtime = "tokio"))]
+impl BreezSdk {
+    /// Each SDK outpoint can be invoked once. No general claim_deposit call,
+    /// automatic sync, saved fee ceiling, early claim, refund or replacement.
+    pub async fn claim_mature_deposit_once(
+        &self,
+        r: MatureDepositClaimRequest,
+    ) -> Result<ClaimDepositResponse, SdkError> {
+        let identity = self.spark_wallet.get_identity_public_key().to_string();
+        let now = || u64::from(breez_sdk_common::utils::now());
+        validate(&r, &identity, self.config.network, now())?;
+        let _guard = self
+            .claim_guards
+            .try_acquire(TxOutput {
+                txid: r.txid.clone(),
+                vout: r.vout,
+            })
+            .ok_or_else(|| invalid("Deposit operation already in progress"))?;
+        let key = marker(&r.txid, r.vout);
+        if self.storage.get_cached_item(key.clone()).await?.is_some() {
+            return Err(invalid(
+                "Deposit claim already attempted; reconcile without resubmitting",
+            ));
+        }
+        if self
+            .stored_deposit(&r.txid, r.vout)
+            .await?
+            .is_some_and(|d| {
+                d.refund_tx.is_some()
+                    || d.instant_claim_status.is_some()
+                    || d.max_claim_fee.is_some()
+            })
+        {
+            return Err(invalid(
+                "An existing refund or deposit mandate requires reconciliation",
+            ));
+        }
+        let utxo = CachedUtxoFetcher::new(self.chain_service.clone(), self.storage.clone())
+            .fetch_detailed_utxo(&r.txid, r.vout)
+            .await?;
+        if utxo.value != r.amount_sats {
+            return Err(invalid("Funding output value differs from authorization"));
+        }
+        let quote = self
+            .spark_wallet
+            .fetch_static_deposit_claim_quote(utxo.tx.clone(), Some(r.vout))
+            .await?;
+        if quote.txid != utxo.txid || quote.output_index != r.vout {
+            return Err(invalid("Deposit quote names another outpoint"));
+        }
+        credit(r.amount_sats, r.max_fee_sats, quote.credit_amount_sats)?;
+        // Never use cached maturity or treat a failed chain query as mature.
+        let status = self
+            .chain_service
+            .get_transaction_status(r.txid.clone())
+            .await?;
+        let tip = self.chain_service.tip_height().await?;
+        depth(
+            status.confirmed,
+            status.block_height,
+            tip,
+            self.config.network,
+        )?;
+        if !matches!(
+            self.chain_service
+                .get_outspend(r.txid.clone(), r.vout)
+                .await?,
+            crate::chain::Outspend::Unspent
+        ) {
+            return Err(invalid("Deposit output is already spent"));
+        }
+        validate(&r, &identity, self.config.network, now())?;
+        let mut intent = serde_json::json!({"version":1,"txid":r.txid,"vout":r.vout,"identity":identity,
+            "network":format!("{:?}",r.network),"amount":r.amount_sats,"maxFee":r.max_fee_sats,"expiresAt":r.expires_at});
+        let encoded = intent.to_string();
+        reserve_attempt(self, &key, None, &encoded).await?;
+        let previous_phase = encoded;
+        validate(&r, &identity, self.config.network, now())?;
+        let transfer_id = self
+            .spark_wallet
+            .claim_static_deposit(&utxo.tx, quote)
+            .await?;
+        intent["transferId"] = serde_json::Value::String(transfer_id.clone());
+        let encoded = intent.to_string();
+        // A continuation may already have reserved receiving while the static
+        // claim acknowledgement was in flight. Never overwrite that phase.
+        reserve_attempt(self, &key, Some(&previous_phase), &encoded).await?;
+        let previous_phase = encoded;
+        let transfer = observation::exact_deposit_transfer(self, &transfer_id)
+            .await?
+            .ok_or_else(|| invalid("Deposit transfer is not yet observable"))?;
+        let p = receipt(&transfer, &r.txid, r.vout, &identity, self.config.network)?;
+        economics(&p, &r)?;
+        if transfer.status != TransferStatus::Completed {
+            require_receivable(&transfer)?;
+            validate(&r, &identity, self.config.network, now())?;
+            intent["receivingAttempted"] = serde_json::Value::Bool(true);
+            let encoded = intent.to_string();
+            reserve_attempt(self, &key, Some(&previous_phase), &encoded).await?;
+            validate(&r, &identity, self.config.network, now())?;
+            self.spark_wallet.process_transfer(transfer).await?;
+        }
+        let observed = self
+            .observe_deposit_claim(FetchClaimDepositQuoteRequest {
+                txid: r.txid.clone(),
+                vout: r.vout,
+            })
+            .await?;
+        if !observed.completed {
+            return Err(invalid("Deposit settlement requires reconciliation"));
+        }
+        let payment = observed
+            .payment
+            .ok_or_else(|| invalid("Deposit receipt missing"))?;
+        economics(&payment, &r)?;
+        self.storage.apply_payment_update(payment.clone()).await?;
+        self.storage.delete_deposit(r.txid, r.vout).await?;
+        Ok(ClaimDepositResponse {
+            outcome: ClaimDepositOutcome::Settled { payment },
+        })
+    }
+
+    /// Continue only a positively correlated deposit whose receiving boundary
+    /// was never crossed. This NEVER submits a static-deposit claim again.
+    /// An interrupted receiving attempt remains observation-only.
+    pub async fn continue_mature_deposit_claim(
+        &self,
+        r: MatureDepositClaimRequest,
+    ) -> Result<ClaimDepositResponse, SdkError> {
+        let identity = self.spark_wallet.get_identity_public_key().to_string();
+        let now = || u64::from(breez_sdk_common::utils::now());
+        validate(&r, &identity, self.config.network, now())?;
+        let _guard = self
+            .claim_guards
+            .try_acquire(TxOutput {
+                txid: r.txid.clone(),
+                vout: r.vout,
+            })
+            .ok_or_else(|| invalid("Deposit operation already in progress"))?;
+        continuation::continue_claim(self, r, identity, self.config.network).await
+    }
+}
