+/// Creates the default external signers from a mnemonic or raw seed bytes.
+///
+/// Preserves the identity of `SdkBuilder.new(config, seed)` when the network and
+/// account number are unchanged. Raw entropy is never reinterpreted as BIP39
+/// mnemonic entropy. Omit `accountNumber` to preserve the network default.
+/// The keys remain in process; this factory does not provide hardware isolation.
+#[wasm_bindgen(js_name = "defaultExternalSignersFromSeed")]
+pub fn default_external_signers_from_seed(
+    seed: Seed,
+    network: Network,
+    account_number: Option<u32>,
+) -> WasmResult<ExternalSigners> {
+    let signers = breez_sdk_spark::default_external_signers_from_seed(
+        seed.into(),
+        network.into(),
+        account_number,
+    )?;
+
+    Ok(ExternalSigners {
+        breez_signer: crate::signer::ExternalBreezSignerHandle::new(signers.breez_signer),
+        spark_signer: crate::signer::ExternalSparkSignerHandle::new(signers.spark_signer),
+    })
+}
