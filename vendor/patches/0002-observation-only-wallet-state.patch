+++ b/crates/breez-sdk/core/src/sdk/observation.rs
@@ -0,0 +1,207 @@
+//! Observation-only operations deliberately do not use `sync_wallet_internal`.
+//! In particular, they never call resume_pending_sends, claim_pending_transfers,
+//! check_and_claim_static_deposits, leaf renewal, recover_funds or a broadcaster.
+use std::str::FromStr;
+use bitcoin::hashes::{sha256, Hash};
+use spark_wallet::{ListTransfersRequest, TransferId, TransferStatus, TransferDirection,
+    SspUserRequest, LightningSendStatus};
+use crate::{GetInfoRequest, GetInfoResponse, ObservePaymentRequest, ObservePaymentResponse,
+    Payment, PaymentDetails, PaymentMethod, PaymentStatus, PaymentType,
+    PaymentObservationOutcome, SparkHtlcStatus, SdkError};
+use crate::sync::SparkSyncService;
+use crate::utils::payments::update_balances;
+use super::BreezSdk;
+
+fn recipient_commitment(rail: &str, recipient: &str) -> String {
+    let mut material = rail.as_bytes().to_vec();
+    material.push(0);
+    material.extend_from_slice(recipient.as_bytes());
+    sha256::Hash::hash(&material).to_string()
+}
+
+fn proven_lightning_completion(payment: &Payment) -> bool {
+    let Some(PaymentDetails::Lightning { invoice, htlc_details, .. }) = &payment.details else { return false; };
+    let Some(preimage) = &htlc_details.preimage else { return false; };
+    let Ok(preimage) = hex::decode(preimage) else { return false; };
+    if preimage.len() != 32 { return false; }
+    let Some(parsed) = breez_sdk_common::input::parse_invoice(invoice) else { return false; };
+    let actual = sha256::Hash::hash(&preimage).to_string();
+    actual.eq_ignore_ascii_case(&htlc_details.payment_hash)
+        && actual.eq_ignore_ascii_case(&parsed.payment_hash)
+}
+
+/// Non-payment requires returned ownership, not a lossy SDK "failed" label.
+fn classify_observation(payment: &Payment, returned: bool, completed: bool,
+    lightning_return_confirmed: bool) -> PaymentObservationOutcome {
+    use PaymentObservationOutcome as O;
+    if payment.payment_type != PaymentType::Send || payment.conversion_details.is_some() { return O::Unresolved; }
+    match payment.method {
+        PaymentMethod::Lightning => {
+            if proven_lightning_completion(payment) { return O::Completed; }
+            let htlc_returned = matches!(&payment.details,
+                Some(PaymentDetails::Lightning { htlc_details, .. })
+                if htlc_details.status == SparkHtlcStatus::Returned && htlc_details.preimage.is_none());
+            if returned && lightning_return_confirmed && htlc_returned { O::Returned } else { O::Unresolved }
+        },
+        PaymentMethod::Spark if completed && payment.status == PaymentStatus::Completed => O::Completed,
+        PaymentMethod::Spark if returned && payment.status == PaymentStatus::Failed => O::Returned,
+        // Withdrawal acceptance alone is not evidence of a final Bitcoin payout.
+        _ => O::Unresolved,
+    }
+}
+
+#[cfg_attr(feature = "uniffi", uniffi::export(async_runtime = "tokio"))]
+impl BreezSdk {
+    /// Observe balances and history without starting new value-moving work.
+    /// Does not claim incoming funds, renew expired leaves or resume a send.
+    pub async fn observe_wallet_state(&self) -> Result<GetInfoResponse, SdkError> {
+        self.spark_wallet.observe_outputs().await?;
+        update_balances(self.spark_wallet.clone(), self.storage.clone()).await?;
+        SparkSyncService::new(self.spark_wallet.clone(), self.storage.clone(), self.event_emitter.clone())
+            .sync_payments(false).await?;
+        self.get_info(GetInfoRequest { ensure_synced: Some(false) }).await
+    }
+
+    /// Query an exact transfer from operators/provider. Missing data is unknown,
+    /// never proof of failure. The caller must also enforce its original intent.
+    pub async fn observe_payment(&self, request: ObservePaymentRequest) -> Result<ObservePaymentResponse, SdkError> {
+        if request.recipient_commitment.len() != 64 || !request.recipient_commitment.bytes().all(|b| b.is_ascii_hexdigit()) {
+            return Err(SdkError::Generic("Invalid recipient commitment".to_string()));
+        }
+        let id = TransferId::from_str(&request.payment_id)
+            .map_err(|_| SdkError::Generic("Invalid observation transfer id".to_string()))?;
+        let result = self.spark_wallet.list_transfers(ListTransfersRequest {
+            transfer_ids: vec![id], ..Default::default()
+        }).await?;
+        let mut response = ObservePaymentResponse {
+            payment_id: request.payment_id.clone(), recipient_commitment: None,
+            identity_pubkey: self.spark_wallet.get_identity_public_key().to_string(),
+            network: self.config.network,
+            observed_at: u64::from(breez_sdk_common::utils::now()),
+            outcome: PaymentObservationOutcome::NotFound, payment: None,
+        };
+        let Some(transfer) = result.items.into_iter().find(|t| t.id.to_string() == request.payment_id) else { return Ok(response); };
+        if transfer.direction != TransferDirection::Outgoing {
+            return Err(SdkError::Generic("Observed transfer does not originate from this wallet".to_string()));
+        }
+        let returned = transfer.status == TransferStatus::Returned;
+        let completed = transfer.status == TransferStatus::Completed;
+        let lightning_return_confirmed = match &transfer.user_request {
+            Some(SspUserRequest::LightningSendRequest(r)) => matches!(
+                LightningSendStatus::from(r.status.clone()), LightningSendStatus::UserSwapReturned),
+            _ => false,
+        };
+        let spark_recipient = transfer.receiver_id.to_string();
+        let mut payment = Payment::try_from(transfer)?;
+        response.outcome = classify_observation(&payment, returned, completed, lightning_return_confirmed);
+        let commitment = match &payment.details {
+            Some(PaymentDetails::Lightning { invoice, .. }) => Some(recipient_commitment("lightning", &invoice.to_lowercase())),
+            Some(PaymentDetails::Withdraw { tx_id }) => {
+                // Provider acceptance is not enough. Check the independently fetched
+                // Bitcoin transaction, txid and exact approved destination/amount.
+                let status = self.chain_service.get_transaction_status(tx_id.clone()).await?;
+                if !status.confirmed { None } else {
+                    let encoded = self.chain_service.get_transaction_hex(tx_id.clone()).await?;
+                    let bytes = hex::decode(encoded).map_err(|_| SdkError::Generic("Invalid payout transaction".to_string()))?;
+                    let transaction: bitcoin::Transaction = bitcoin::consensus::deserialize(&bytes)
+                        .map_err(|_| SdkError::Generic("Invalid payout transaction".to_string()))?;
+                    if transaction.compute_txid().to_string() != *tx_id {
+                        return Err(SdkError::Generic("Payout transaction id mismatch".to_string()));
+                    }
+                    let mut received = 0u128;
+                    for output in &transaction.output {
+                        let Ok(address) = bitcoin::Address::from_script(&output.script_pubkey, bitcoin::Network::from(self.config.network)) else { continue; };
+                        if recipient_commitment("bitcoin", &address.to_string()) == request.recipient_commitment {
+                            received = received.checked_add(u128::from(output.value.to_sat()))
+                                .ok_or_else(|| SdkError::Generic("Invalid payout value".to_string()))?;
+                        }
+                    }
+                    if received >= payment.amount && payment.amount > 0 {
+                        response.outcome = PaymentObservationOutcome::Completed;
+                        Some(request.recipient_commitment.clone())
+                    } else { None }
+                }
+            },
+            _ if payment.method == PaymentMethod::Spark => Some(recipient_commitment("spark", &spark_recipient)),
+            _ => None,
+        };
+        if let Some(actual) = &commitment {
+            if actual != &request.recipient_commitment {
+                return Err(SdkError::Generic("Observed recipient differs from approved payment".to_string()));
+            }
+        } else { response.outcome = PaymentObservationOutcome::Unresolved; }
+        if response.outcome == PaymentObservationOutcome::Completed { payment.status = PaymentStatus::Completed; }
+        if response.outcome == PaymentObservationOutcome::Returned { payment.status = PaymentStatus::Failed; }
+        response.recipient_commitment = commitment;
+        response.payment = Some(payment);
+        Ok(response)
+    }
+}
+
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn fixture(method: PaymentMethod, status: PaymentStatus) -> Payment {
+        Payment { id: "disposable-observation-fixture".to_string(), payment_type: PaymentType::Send,
+            status, amount: 100, fees: 2, timestamp: 1, method, details: None, conversion_details: None }
+    }
+    fn lightning_return() -> Payment {
+        let mut p = fixture(PaymentMethod::Lightning, PaymentStatus::Failed);
+        p.details = Some(PaymentDetails::Lightning {
+            description: None, invoice: "unpayable-test-fixture".to_string(), destination_pubkey: "".to_string(),
+            htlc_details: crate::SparkHtlcDetails { payment_hash: "00".repeat(32), preimage: None,
+                expiry_time: 1, status: SparkHtlcStatus::Returned },
+            lnurl_pay_info: None, lnurl_withdraw_info: None, lnurl_receive_metadata: None, conversion_info: None,
+        }); p
+    }
+    #[test]
+    fn observation_generic_failure_is_never_a_refund() {
+        for method in [PaymentMethod::Spark, PaymentMethod::Lightning, PaymentMethod::Withdraw] {
+            assert_eq!(classify_observation(&fixture(method, PaymentStatus::Failed), false, false, false),
+                PaymentObservationOutcome::Unresolved);
+        }
+    }
+    #[test]
+    fn observation_spark_return_requires_operator_return_and_failed_projection() {
+        assert_eq!(classify_observation(&fixture(PaymentMethod::Spark, PaymentStatus::Failed), true, false, false), PaymentObservationOutcome::Returned);
+        assert_eq!(classify_observation(&fixture(PaymentMethod::Spark, PaymentStatus::Pending), true, false, false), PaymentObservationOutcome::Unresolved);
+    }
+    #[test]
+    fn observation_spark_completion_requires_final_operator_status() {
+        let p = fixture(PaymentMethod::Spark, PaymentStatus::Completed);
+        assert_eq!(classify_observation(&p, false, false, false), PaymentObservationOutcome::Unresolved);
+        assert_eq!(classify_observation(&p, false, true, false), PaymentObservationOutcome::Completed);
+    }
+    #[test]
+    fn observation_lightning_return_needs_operator_provider_and_htlc_agreement() {
+        let p = lightning_return();
+        assert_eq!(classify_observation(&p, true, false, true), PaymentObservationOutcome::Returned);
+        assert_eq!(classify_observation(&p, false, false, true), PaymentObservationOutcome::Unresolved);
+        assert_eq!(classify_observation(&p, true, false, false), PaymentObservationOutcome::Unresolved);
+    }
+    #[test]
+    fn observation_preimage_conflict_keeps_return_unresolved() {
+        let mut p = lightning_return();
+        if let Some(PaymentDetails::Lightning { htlc_details, .. }) = &mut p.details {
+            htlc_details.preimage = Some("11".repeat(32));
+        }
+        assert_eq!(classify_observation(&p, true, false, true), PaymentObservationOutcome::Unresolved);
+    }
+    #[test]
+    fn observation_withdrawal_acceptance_is_not_payout_proof() {
+        let p = fixture(PaymentMethod::Withdraw, PaymentStatus::Completed);
+        assert_eq!(classify_observation(&p, false, true, false), PaymentObservationOutcome::Unresolved);
+    }
+    #[test]
+    fn observation_completed_label_without_preimage_never_proves_lightning_payment() {
+        let p = fixture(PaymentMethod::Lightning, PaymentStatus::Completed);
+        assert_eq!(classify_observation(&p, false, true, false), PaymentObservationOutcome::Unresolved);
+    }
+    #[test]
+    fn observation_incoming_record_cannot_resolve_outgoing_operation() {
+        let mut p = fixture(PaymentMethod::Spark, PaymentStatus::Completed);
+        p.payment_type = PaymentType::Receive;
+        assert_eq!(classify_observation(&p, false, true, false), PaymentObservationOutcome::Unresolved);
+    }
+}
