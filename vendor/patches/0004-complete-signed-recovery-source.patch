+    #[test] fn incoming_claim_invalid_transfer_id() { let mut r=request(); r.payment_id="not-a-transfer".into(); assert!(validate_intent(&r,"disposable",Network::Regtest,100).is_err()); }
+    fn receipt(from_ssp: bool) -> (WalletTransfer, IncomingTransferRequest) {
+        use spark_wallet::{PublicKey, Transfer};
+        let pk = |fill: u8| { let mut b = [fill; 33]; b[0] = 2; PublicKey::from_slice(&b).unwrap() };
+        let (ours, other, ssp) = (pk(1), pk(7), pk(2));
+        let r = IncomingTransferRequest { identity_pubkey: ours.to_string(), ..request() };
+        let t = Transfer { id: TransferId::from_str(&r.payment_id).unwrap(),
+            sender_identity_public_key: if from_ssp { ssp } else { other }, receiver_identity_public_key: ours,
+            status: TransferStatus::SenderKeyTweaked, total_value: r.amount_sats, expiry_time: None,
+            leaves: Vec::new(), created_time: None, updated_time: None,
+            transfer_type: TransferType::Transfer, spark_invoice: None };
+        (WalletTransfer::from_transfer(t, None, None, ours, ssp), r)
+    }
+    #[test] fn incoming_claim_plain_peer_receipt() { let (t,r)=receipt(false); assert!(exact_transfer(&t,&r).is_ok()); }
+    #[test] fn incoming_claim_plain_ssp_receipt() { let (t,r)=receipt(true); assert!(t.is_ssp_transfer); assert!(exact_transfer(&t,&r).is_ok()); }
+    #[test] fn incoming_claim_wrong_receiver() { let (t,mut r)=receipt(true); r.identity_pubkey=t.sender_id.to_string(); assert!(exact_transfer(&t,&r).is_err()); }
+    #[test] fn incoming_claim_wrong_transfer_id() { let (t,mut r)=receipt(true); r.payment_id=TransferId::generate().to_string(); assert!(exact_transfer(&t,&r).is_err()); }
+    #[test] fn incoming_claim_wrong_direction() { let (mut t,r)=receipt(true); t.direction=TransferDirection::Outgoing; assert!(exact_transfer(&t,&r).is_err()); }
+    #[test] fn incoming_claim_wrong_amount() { let (t,mut r)=receipt(true); r.amount_sats+=1; assert!(exact_transfer(&t,&r).is_err()); }
+    #[test] fn incoming_claim_rejects_other_protocols() {
+        for ty in [TransferType::PreimageSwap,TransferType::CooperativeExit,TransferType::UtxoSwap,
+            TransferType::Swap,TransferType::CounterSwap,TransferType::PrimarySwapV3,TransferType::CounterSwapV3,TransferType::Unknown] {
+            let (mut t,r)=receipt(true);t.transfer_type=ty;assert!(exact_transfer(&t,&r).is_err());
+        }
+    }
+    #[test] fn incoming_claim_rejects_htlc_on_plain_transfer() {
+        use bitcoin::hashes::{sha256,Hash};
+        let (mut t,r)=receipt(true);
+        t.htlc_preimage_request=Some(spark_wallet::PreimageRequest { payment_hash:sha256::Hash::hash(b"test"),
+            status:spark_wallet::PreimageRequestStatus::WaitingForPreimage,
+            created_time:platform_utils::time::UNIX_EPOCH,expiry_time:platform_utils::time::UNIX_EPOCH,preimage:None });
+        assert!(exact_transfer(&t,&r).is_err());
+    }
+    #[test] fn incoming_claim_rejects_ssp_request_on_plain_transfer() {
+        use spark_wallet::{SspUserRequest,LightningSendRequest,LightningSendRequestStatus,BitcoinNetwork,CurrencyAmount,CurrencyUnit};
+        let (mut t,r)=receipt(true);
+        t.user_request=Some(SspUserRequest::LightningSendRequest(LightningSendRequest {
+            id:"request".into(),created_at:chrono::Utc::now(),updated_at:chrono::Utc::now(),network:BitcoinNetwork::Regtest,
+            encoded_invoice:"not an invoice".into(),fee:CurrencyAmount { original_value:0,original_unit:CurrencyUnit::Satoshi,
+                preferred_currency_unit:CurrencyUnit::Satoshi,preferred_currency_value_rounded:0 },
+            idempotency_key:"test".into(),status:LightningSendRequestStatus::LightningPaymentSucceeded,
+            transfer:None,lightning_send_payment_preimage:None }));
+        assert!(exact_transfer(&t,&r).is_err());
+    }
