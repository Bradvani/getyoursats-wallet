# GetYourSats Wallet Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# REQUIRED
# =============================================================================

# Breez API key for SDK initialization
# Request a browser-distributable SDK key using the contact form at https://breez.technology/sdk/
# IMPORTANT: VITE_ variables are public in the built browser bundle.
VITE_BREEZ_API_KEY=your_breez_api_key_here

# =============================================================================
# OPTIONAL
# =============================================================================

# Client-side preview convenience only; NOT access control.
# VITE_STAGING_PASSWORD is visible in the built browser bundle and bypassable.
# Use hosting-level deployment protection for private previews.
# VITE_STAGING_PASSWORD=

# Console logging override
# "true" = always enabled, "false" = always disabled
# Default: enabled in dev mode, disabled in production
# VITE_CONSOLE_LOGGING=true

# Passkey Relying Party ID for cross-app passkey sharing
# Enables passkeys created in GetYourSats to work across approved associated apps
# Requires server-side .well-known/webauthn configuration at the rpID domain
# Default: current hostname (passkeys only work on this domain)
# VITE_PASSKEY_RP_ID=keys.breez.technology

# Base path for subpath deployment
# Must include leading and trailing slashes
# Default: / (root)
# VITE_BASE_PATH=/wallet/

# =============================================================================
# SERVER
# =============================================================================

# Server host binding
# Use "0.0.0.0" to allow LAN access (e.g., for testing on mobile devices)
# Default: localhost
# VITE_SERVER_HOST=0.0.0.0

# Allowed hosts for the server (comma-separated)
# Required when accessing via IP or custom hostname
# Example: 192.168.1.100,my-dev-machine.local
# VITE_SERVER_ALLOWED_HOSTS=

# Custom GetYourSats LNURL domain is intentionally inactive until
# verified account linking/username entitlement and Breez domain approval.
# Do not set VITE_GETYOURSATS_LNURL_DOMAIN in production yet.

# Enable passkey-first onboarding only after canonical HTTPS app origin is
# controlled and verified, and WebAuthn PRF restore works across devices.
# Requires EXACT https://origin without trailing slash or path.
# VITE_GETYOURSATS_PASSKEY_ORIGIN=https://wallet.example.com
# Native requires verified iOS AASA / Android Digital Asset Links with the
# correct team IDs, signing certs and RP ID before setting this true.
# VITE_GETYOURSATS_NATIVE_PASSKEY_READY=false

# Legacy upstream MoonPay/Cash App flows are NOT approved GetYourSats INR/UPI ramps.
# Leave disabled for India beta; requires independent partner review.
# VITE_GETYOURSATS_ENABLE_LEGACY_BUY=false
